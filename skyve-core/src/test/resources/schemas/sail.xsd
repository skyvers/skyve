    <xs:attribute name="model" type="xs:string"/>
    <xs:attribute name="module" type="xs:string"/>
    <xs:attribute name="query" type="xs:string"/>
    <xs:attribute name="tool" type="tns:tool" use="required"/>
  </xs:complexType>

  <xs:complexType name="interaction">
    <xs:sequence>
      <xs:element name="before" type="tns:procedure" form="qualified" minOccurs="0"/>
      <xs:element name="method" form="qualified" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="tns:login"/>
              <xs:element ref="tns:logout"/>
              <xs:element ref="tns:navigateList"/>
              <xs:element ref="tns:navigateTree"/>
              <xs:element ref="tns:navigateMap"/>
              <xs:element ref="tns:navigateCalendar"/>
              <xs:element ref="tns:pushListContext"/>
              <xs:element ref="tns:navigateEdit"/>
              <xs:element ref="tns:navigateLink"/>
              <xs:element ref="tns:tabSelect"/>
              <xs:element ref="tns:testDataEnter"/>
              <xs:element ref="tns:dataEnter"/>
              <xs:element ref="tns:ok"/>
              <xs:element ref="tns:save"/>
              <xs:element ref="tns:cancel"/>
              <xs:element ref="tns:delete"/>
              <xs:element ref="tns:zoomOut"/>
              <xs:element ref="tns:remove"/>
              <xs:element ref="tns:action"/>
              <xs:element ref="tns:lookupDescriptionAutoComplete"/>
              <xs:element ref="tns:lookupDescriptionPick"/>
              <xs:element ref="tns:lookupDescriptionNew"/>
              <xs:element ref="tns:lookupDescriptionEdit"/>
              <xs:element ref="tns:zoomIn"/>
              <xs:element ref="tns:dataGridNew"/>
              <xs:element ref="tns:dataGridZoom"/>
              <xs:element ref="tns:dataGridEdit"/>
              <xs:element ref="tns:dataGridRemove"/>
              <xs:element ref="tns:dataGridSelect"/>
              <xs:element ref="tns:listGridNew"/>
              <xs:element ref="tns:listGridZoom"/>
              <xs:element ref="tns:listGridSelect"/>
              <xs:element ref="tns:testValue"/>
              <xs:element ref="tns:testSuccess"/>
              <xs:element ref="tns:testFailure"/>
              <xs:element ref="tns:comment"/>
              <xs:element ref="tns:execute"/>
              <xs:element ref="tns:pause"/>
              <xs:element ref="tns:pushEditContext"/>
              <xs:element ref="tns:popContext"/>
              <xs:element ref="tns:clearContext"/>
              <xs:element ref="tns:upload"/>
              <xs:element ref="tns:testMessage"/>
              <xs:element ref="tns:testGridRows"/>
              <xs:element ref="tns:testWidget"/>
              <xs:element ref="tns:navigateMenu"/>
              <xs:element ref="tns:testMenu"/>
              <xs:element ref="tns:switchMode"/>
              <xs:element ref="tns:listGridFilter"/>
              <xs:element ref="tns:listGridClearFilter"/>
              <xs:element ref="tns:listGridSort"/>
              <xs:element ref="tns:captureValue"/>
              <xs:element ref="tns:captureCell"/>
              <xs:element ref="tns:captureTitle"/>
              <xs:element ref="tns:dataGridLink"/>
              <xs:element ref="tns:dataGridMove"/>
              <xs:element ref="tns:listMembershipMove"/>
              <xs:element ref="tns:navigateBack"/>
              <xs:element ref="tns:refresh"/>
              <xs:element ref="tns:closeWindow"/>
              <xs:element ref="tns:listGridTool"/>
            </xs:choice>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="after" type="tns:procedure" form="qualified" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="workflow">
    <xs:sequence>
      <xs:element ref="tns:automation" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="testStrategy" type="tns:testStrategy">
      <xs:annotation>
        <xs:documentation>
          The default test strategy for the automations that state none; an automation's own testStrategy wins.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="suite">
    <xs:sequence>
      <xs:element name="viewRoles" type="tns:viewRoles" form="qualified" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            The roles the runner builds views with for one user that the members sign in as; one per user.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="setUp" type="tns:suiteMember" form="qualified" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            A set-up member: runs first, in order, locked to its own test strategy. Every later set-up member and every
            ordinary member requires it.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="member" type="tns:ordinarySuiteMember" form="qualified" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            An ordinary member: runs in order after the set-up members; a failure does not stop the others.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="restore" type="tns:suiteMember" form="qualified" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            The restore member: runs last, even after failures, if its own requirements passed. It can require only
            set-up members, and is locked to its own test strategy.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="testStrategy" type="tns:testStrategy">
      <xs:annotation>
        <xs:documentation>
          The default test strategy for the automations of unlocked members that state none; a workflow's or an
          automation's own testStrategy wins. Set-up, restore and lockTestStrategy="true" members ignore it.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="evidence" type="tns:evidence">
      <xs:annotation>
        <xs:documentation>The evidence the suite asks its run to keep; the run can override it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="viewRoles">
    <xs:sequence>
      <xs:element name="role" type="xs:token" form="qualified" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>A role: module.Role, or a customer role's name.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="user" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>The user name as the members sign in with it; can hold {run} and {var:name}.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="suiteMember" block="#all">
    <xs:sequence/>
    <xs:attribute name="file" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          The workflow or automation file: a normalised path relative to the suite file's folder, with / between
          folders and no . or .. segments. It also names the member in requires.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="requires">
      <xs:annotation>
        <xs:documentation>
          Space-separated files of earlier members that must pass before this one runs; otherwise it is skipped.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:list itemType="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ordinarySuiteMember" block="#all">
    <xs:complexContent>
      <xs:extension base="tns:suiteMember">
        <xs:sequence/>
        <xs:attribute name="lockTestStrategy" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>
              true to run this member with its own test strategy, ignoring a run's override and the suite's default.
              Default false.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="testStrategy">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Assert"/>
      <xs:enumeration value="Verify"/>
      <xs:enumeration value="None"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="evidence">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="failures"/>
      <xs:enumeration value="snapshots"/>
      <xs:enumeration value="video"/>
      <xs:enumeration value="all"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="window">
    <xs:restriction base="xs:string">
      <xs:enumeration value="new"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="match">
    <xs:restriction base="xs:string">
      <xs:enumeration value="index"/>
      <xs:enumeration value="code"/>
      <xs:enumeration value="label"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="messageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="filterOperator">
    <xs:restriction base="xs:string">
      <xs:enumeration value="contains"/>
      <xs:enumeration value="startsWith"/>
      <xs:enumeration value="equals"/>
      <xs:enumeration value="notEquals"/>
      <xs:enumeration value="lessThan"/>
      <xs:enumeration value="greaterThan"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tool">
    <xs:restriction base="xs:string">
      <xs:enumeration value="refresh"/>
      <xs:enumeration value="clearSelection"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>

