<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Admin suite (admin.suite.xml), set-up after 00-backup.xml, in SmartClient: leave a marker after the backups, which
	99-restore.xml checks that the restore removed (and 00-precondition.xml checks that no earlier run left behind).
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Signs in as admin in SmartClient (desktop UX/UI) and leaves a data group behind after the backups, as a marker that only a successful restore can remove.</description>
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
		<switchMode />
	</before>
	<interaction name="Leave a marker that the restore must remove">
		<description>Creates a data group named SAIL restore marker and checks it is listed, so the restore at the end of the suite can prove it took the data back to the backup.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Data Groups" />
			<listGridNew module="admin" document="DataGroup" />
			<dataEnter binding="name" value="SAIL restore marker" />
			<save />
			<ok />
			<testGridRows module="admin" document="DataGroup" rowContaining="SAIL restore marker" minRows="1" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
