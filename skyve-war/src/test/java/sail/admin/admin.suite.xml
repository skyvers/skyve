<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	The admin module suite, across both renderers: every admin menu item and the actions behind it, in PrimeFaces (pf/,
	tablet; pf/10-phone-smoke.xml on a phone) and SmartClient (sc/). Run it only against a disposable server: it backs up,
	changes, truncates and restores the data. AdminSuiteSailIT runs it; so can SailRunIT (-Dsail.run=sail/admin/admin.suite.xml).

	The bracket, across both renderers: 00-precondition.xml (PrimeFaces) checks that no earlier run left its restore
	marker; 00-backup.xml (a workflow) clears the completed jobs list and backs up in PrimeFaces, then clears it again and
	backs up in SmartClient; 00-marker.xml (SmartClient) leaves the marker that the restore must remove. Every member
	requires the set-ups, so when one fails nothing else runs. 99-restore.xml (a workflow) restores the newest backup
	(SmartClient's) once, checks the marker has gone in both renderers, and each renderer deletes one backup; it runs
	last, after failures too, but only when the precondition and the backup passed (otherwise the newest backup could be
	another one).

	Members are independent: each signs in, makes what it needs with its own run token, and cleans up. None requires another.
	The order still matters for one thing: the 05-reports-misc.xml members check the backup job's row in the completed jobs
	list, and the 98-destructive.xml members clear that list, so the destructive members run after every other one, and
	sc/99-truncate.xml (SmartClient's Truncate) runs last, just before the restore.

	-Dsail.suite.only=pf/ or sc/ runs one renderer (the bracket always runs); -Dsail.suite.only=03 runs both 03 members.
	Each member's strategy is its own (Assert); -Dsail.testStrategy=Verify applies to the ordinary members, while the set-ups
	and the restore stay locked to theirs.
-->
<suite xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
		xmlns="http://www.skyve.org/xml/sail"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<viewRoles user="sail{run}">
		<!-- 03-security-admin.xml makes this user in a group with these roles, then signs in as them -->
		<role>admin.BasicUser</role>
		<role>admin.ContactViewer</role>
	</viewRoles>
	<setUp file="00-precondition.xml"/>
	<setUp file="00-backup.xml"/>
	<setUp file="00-marker.xml"/>
	<member file="pf/01-session.xml"/>
	<member file="pf/02-contacts-communications.xml"/>
	<member file="pf/03-security-admin.xml"/>
	<member file="pf/04-devops.xml"/>
	<member file="pf/05-reports-misc.xml"/>
	<member file="pf/10-phone-smoke.xml"/>
	<member file="sc/01-session.xml"/>
	<member file="sc/02-contacts-communications.xml"/>
	<member file="sc/03-security-admin.xml"/>
	<member file="sc/04-devops.xml"/>
	<member file="sc/05-reports-misc.xml"/>
	<member file="pf/98-destructive.xml"/>
	<member file="sc/98-destructive.xml"/>
	<member file="sc/99-truncate.xml"/>
	<restore file="99-restore.xml" requires="00-precondition.xml 00-backup.xml"/>
</suite>
