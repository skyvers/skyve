<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	SmartClient admin suite: the dangerous actions, run against the disposable test server only, after everything else and
	before 99-restore.xml puts the data back. Configuration is saved with explicit, safe values (never testDataEnter, never
	anything that could lock admin out).
	SmartClient only: DropIndexing (then Reindex, so that later runs search an index) and TruncateAuditLog here, and
	Truncate in 99-restore.xml, just before the restore. RunJobNow needs the job scheduler, which the test server runs without.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
		<switchMode />
	</before>
	<interaction name="Configuration: save safe values (mail is only logged)">
		<method>
			<navigateMenu module="admin" item="Security Admin/Configuration" />
			<tabSelect path="General" />
			<testValue binding="passwordMinLength" value="12" />
			<tabSelect path="Startup Configuration" />
			<dataEnter binding="startup.mailBogusSend" value="true" />
			<dataEnter binding="startup.mailTestRecipient" value="sail.test@example.com" />
			<save />
			<testSuccess />
			<testValue binding="startup.mailBogusSend" value="true" />
			<navigateMenu module="admin" item="Security Admin/Configuration" />
			<tabSelect path="Startup Configuration" />
			<testValue binding="startup.mailBogusSend" value="true" />
		</method>
	</interaction>
	<interaction name="Mail: a test email, and sends that refuse without recipients">
		<method>
			<navigateMenu module="admin" item="Security Admin/Configuration" />
			<tabSelect path="General" />
			<comment>The test email form shows only when email is configured, which the test server's localhost SMTP is not</comment>
			<testWidget binding="emailTo" visible="false" />
			<!-- PHASE3: with a configured mail server, enter emailTo/emailSubject and run SendMail -->
			<navigateMenu module="admin" item="Communication/Communications" />
			<listGridNew module="admin" document="Communication" />
			<tabSelect path="Contents" />
			<dataEnter binding="description" value="SAIL Send {run}" />
			<save />
			<tabSelect path="Manage" />
			<action name="SendNow" testSuccess="false" />
			<testFailure message="must be selected" />
			<!--
				RUNTIME BUG (SmartClient): after SendNow's "tag" field error, SmartClient sends no later validating action, so
				this communication cannot be deleted here; 99-restore.xml removes it with the rest of the suite's data.
			<delete />
			-->
			<cancel />
		</method>
	</interaction>
	<interaction name="Test data: generate tagged data, rerun the job, then delete the tagged data">
		<method>
			<navigateMenu module="admin" item="DevOps/Control Panel" />
			<tabSelect path="Design" />
			<dataEnter binding="testModuleName" value="1" />
			<testValue binding="testModuleName" value="admin" />
			<dataEnter binding="testDocumentNames" value="Contact" />
			<dataEnter binding="testNumberToGenerate" value="3" />
			<dataEnter binding="testTagGeneratedData" value="true" />
			<dataEnter binding="testTagName" value="SAIL{run}" />
			<action name="GenerateTestData" />
			<pause millis="5000" />
			<navigateMenu module="admin" item="Jobs" />
			<tabSelect path="Actual" />
			<testGridRows module="admin" query="qCompletedJobs" rowContaining="Generate" minRows="1" timeoutMillis="30000" />
			<listGridZoom module="admin" query="qCompletedJobs" rowContaining="Generate" />
			<action name="RerunJob" />
			<cancel />
			<navigateMenu module="admin" item="DevOps/Control Panel" />
			<tabSelect path="Design" />
			<dataEnter binding="testTagName" value="SAIL{run}" />
			<action name="DeleteTestData" />
			<pause millis="5000" />
		</method>
	</interaction>
	<interaction name="Data Maintenance: drop the content index, then reindex">
		<method>
			<navigateMenu module="admin" item="DevOps/Data Maintenance" />
			<tabSelect path="Content" />
			<action name="DropIndexing" />
			<testSuccess />
			<action name="Reindex" />
			<testSuccess />
		</method>
	</interaction>
	<interaction name="Data Maintenance: truncate the audit log">
		<method>
			<navigateMenu module="admin" item="DevOps/Data Maintenance" />
			<tabSelect path="Manage Audits" />
			<action name="CheckAuditMatches" />
			<testWidget action="TruncateAuditLog" enabled="true" />
			<action name="TruncateAuditLog" />
			<testSuccess />
			<comment>Truncating is a job: wait for it to finish</comment>
			<navigateMenu module="admin" item="Jobs" />
			<tabSelect path="Actual" />
			<testGridRows module="admin" query="qCompletedJobs" rowContaining="Truncate" minRows="1" timeoutMillis="60000" />
		</method>
	</interaction>
	<interaction name="Jobs: delete the completed jobs">
		<method>
			<navigateMenu module="admin" item="Jobs" />
			<action name="DeleteCompletedJobs" confirm="false" />
			<action name="DeleteCompletedJobs" />
			<action name="Refresh" />
			<testGridRows module="admin" query="qCompletedJobs" maxRows="0" timeoutMillis="10000" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
