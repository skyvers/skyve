<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	SmartClient admin suite, step 0: check that the server has no backup and no restore marker.
	99-restore.xml restores the first backup listed, which is the oldest (runtime bug), so the one restored must be the one
	00-backup.xml makes. SmartClientAdminSuiteSailIT runs nothing else, and restores nothing, when this fails.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
		<switchMode />
	</before>
	<interaction name="Precondition: no stray backup or restore marker">
		<method>
			<comment>99-restore.xml restores the first backup listed (the oldest), so a stray backup (an interrupted run, a suite whose restore failed) would roll the database back to an unknown state. If this fails, delete the stray backups (Data Maintenance, Backup/Restore) and any SAIL restore marker data group, check the data, and run again. SmartClientAdminSuiteSailIT then runs nothing else.</comment>
			<navigateEdit module="admin" document="DataMaintenance" />
			<tabSelect path="Backup/Restore" />
			<testGridRows module="admin" query="BackupsModel" maxRows="0" />
			<navigateMenu module="admin" item="Security Admin/Data Groups" />
			<testGridRows module="admin" document="DataGroup" rowContaining="SAIL restore marker" maxRows="0" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
