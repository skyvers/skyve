<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Admin suite (admin.suite.xml), SmartClient: Security Admin. Data groups, groups with roles, a user made with the wizard who then signs in
	(role-filtered menu) and changes their password, then Configuration (looked at, never saved here), Sign In History,
	Security Log and Mail Log.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Signs in as admin in SmartClient (desktop UX/UI) and walks through Security Admin: making a group and a user, the new user's own sign in and password change, the logs, and the configuration screen.</description>
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
		<switchMode />
	</before>
	<interaction name="Data Groups: create, find and delete">
		<description>Creates a data group, finds it in the list, and deletes it, checking it has gone.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Data Groups" />
			<listGridNew module="admin" document="DataGroup" />
			<dataEnter binding="name" value="SAIL Data Group {run}" />
			<dataEnter binding="description" value="A SAIL data group" />
			<save />
			<testValue binding="name" value="SAIL Data Group {run}" />
			<ok />
			<testGridRows module="admin" document="DataGroup" rowContaining="SAIL Data Group {run}" minRows="1" maxRows="1" />
			<listGridZoom module="admin" document="DataGroup" rowContaining="SAIL Data Group {run}" />
			<delete />
			<testGridRows module="admin" document="DataGroup" rowContaining="SAIL Data Group {run}" maxRows="0" />
		</method>
	</interaction>
	<interaction name="Groups: a group needs roles">
		<description>Tries to save a group with no roles and checks it is refused, then gives it two roles and saves it, checking the group is listed.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Groups" />
			<listGridNew module="admin" document="Group" />
			<tabSelect path="Group Details" />
			<dataEnter binding="name" value="SAIL Group {run}" />
			<dataEnter binding="description" value="A SAIL group" />
			<save testSuccess="false" />
			<testFailure />
			<dataEnter binding="roles" value="Admin - BasicUser (General access to the administration module)|Admin - ContactViewer (View-only access to contact details)" />
			<save />
			<testValue binding="roles" value="Admin - BasicUser (General access to the administration module)|Admin - ContactViewer (View-only access to contact details)" />
			<tabSelect path="Users in Group" />
			<ok />
			<testGridRows module="admin" document="Group" rowContaining="SAIL Group {run}" minRows="1" maxRows="1" />
		</method>
	</interaction>
	<interaction name="Users: make a user with the wizard">
		<description>Makes a user with the wizard: searches for a contact, makes a new one, sets a user name and password, picks the group, and checks the user is listed with its groups.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Users" />
			<tabSelect path="Users" />
			<testGridRows module="admin" query="qUsers" rowContaining="admin" minRows="1" />
			<listGridNew module="admin" query="qUsers" createView="true" />
			<comment>Step 1: look for a contact, then make a new one</comment>
			<dataEnter binding="searchContactName" value="SAIL User {run}" />
			<dataEnter binding="searchEmail" value="sailuser.{run}@example.com" />
			<action name="Check" />
			<action name="New" />
			<comment>Step 2: user name and password</comment>
			<testValue binding="contact.name" value="SAIL User {run}" />
			<testWidget binding="contact.name" enabled="false" />
			<testValue binding="contact.email1" value="sailuser.{run}@example.com" />
			<dataEnter binding="userName" value="sail{run}" />
			<dataEnter binding="newPassword" value="Sail{run}Pass1" />
			<dataEnter binding="confirmPassword" value="Sail{run}Pass1" />
			<action name="Next" />
			<comment>Step 3: groups</comment>
			<dataEnter binding="groups" value="SAIL Group {run}" />
			<save createView="false" />
			<testSuccess />
			<testValue binding="userName" value="sail{run}" />
			<tabSelect path="Profile" />
			<tabSelect path="Groups" />
			<testValue binding="groups" value="SAIL Group {run}" />
			<tabSelect path="Roles" />
			<tabSelect path="Password" />
			<tabSelect path="Profile" />
			<ok />
			<tabSelect path="Users" />
			<testGridRows module="admin" query="qUsers" rowContaining="sail{run}" minRows="1" maxRows="1" />
		</method>
	</interaction>
	<interaction name="The new user signs in and changes their password">
		<description>Signs in as the new user, checks the menu matches the user's roles, rejects a too-short new password, changes the password, and checks only the new one signs in.</description>
		<method>
			<logout />
			<login user="sail{run}" password="Sail{run}Pass1" />
			<testSuccess />
			<switchMode />
			<comment>The user's roles decide the menu</comment>
			<testMenu module="admin" item="Contacts" />
			<testMenu module="admin" item="Password" />
			<testMenu module="admin" item="Security Admin/Users" present="false" />
			<testMenu module="admin" item="DevOps/Control Panel" present="false" />
			<navigateMenu module="admin" item="Password" />
			<dataEnter binding="oldPassword" value="Sail{run}Pass1" />
			<dataEnter binding="newPassword" value="short" />
			<dataEnter binding="confirmPassword" value="short" />
			<action name="MakePasswordChange" testSuccess="false" />
			<testFailure />
			<dataEnter binding="oldPassword" value="Sail{run}Pass1" />
			<dataEnter binding="newPassword" value="Sail{run}Pass2" />
			<dataEnter binding="confirmPassword" value="Sail{run}Pass2" />
			<action name="MakePasswordChange" />
			<logout />
			<login user="sail{run}" password="Sail{run}Pass1" />
			<testFailure />
			<login user="sail{run}" password="Sail{run}Pass2" />
			<testSuccess />
			<switchMode />
			<logout />
			<login user="admin" password="admin" />
			<testSuccess />
			<switchMode />
		</method>
	</interaction>
	<interaction name="Sign In History and Security Log show the sign ins">
		<description>Checks the new user's sign ins appear in Sign In History and opens the Security Log.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Sign In History" />
			<testGridRows module="admin" query="qLoginHistory" rowContaining="sail{run}" minRows="1" />
			<listGridZoom module="admin" query="qLoginHistory" rowContaining="sail{run}" />
			<cancel />
			<navigateMenu module="admin" item="Security Admin/Security Log" />
			<testGridRows module="admin" document="SecurityLog" minRows="0" />
		</method>
	</interaction>
	<interaction name="Delete the user and the group">
		<description>Deletes the new user and then the group, checking each has gone from its list.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Users" />
			<tabSelect path="Users" />
			<listGridZoom module="admin" query="qUsers" rowContaining="sail{run}" />
			<delete />
			<tabSelect path="Users" />
			<testGridRows module="admin" query="qUsers" rowContaining="sail{run}" maxRows="0" />
			<navigateMenu module="admin" item="Security Admin/Groups" />
			<listGridZoom module="admin" document="Group" rowContaining="SAIL Group {run}" />
			<delete />
			<testGridRows module="admin" document="Group" rowContaining="SAIL Group {run}" maxRows="0" />
		</method>
	</interaction>
	<interaction name="Configuration: every tab (saved only in 98-destructive)">
		<description>Opens Configuration and visits its tabs without saving, which the destructive script does later.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Configuration" />
			<tabSelect path="General" />
			<testWidget binding="passwordMinLength" enabled="true" />
			<tabSelect path="Startup Configuration" />
			<tabSelect path="General" />
		</method>
	</interaction>
	<interaction name="Mail Log">
		<description>Opens the Mail Log and checks its Database Mail Logs tab shows.</description>
		<method>
			<navigateMenu module="admin" item="Security Admin/Mail Log" />
			<testWidget tab="Database Mail Logs" />
		</method>
	</interaction>
	<interaction name="Groups: generated data, with a role, saved twice">
		<description>Opens Groups and saves a group filled with generated test data and a role twice, then deletes it.</description>
		<method>
			<navigateList document="Group" module="admin" />
			<listGridNew document="Group" module="admin" />
			<testDataEnter />
			<comment>A group needs at least one role to save: assign one, as a user would (select it, press assign)</comment>
			<tabSelect path="Group Details" />
			<dataEnter binding="roles" value="Admin - BasicUser (General access to the administration module)" />
			<testValue binding="roles" value="Admin - BasicUser (General access to the administration module)" />
			<tabSelect path="Group Details" />
			<tabSelect path="Users in Group" />
			<save />
			<testDataEnter />
			<save />
			<tabSelect path="Group Details" />
			<tabSelect path="Users in Group" />
			<comment>delete rather than cancel, so that repeated runs do not leave groups behind</comment>
			<delete />
		</method>
	</interaction>
	<interaction name="Data Groups: generated data, saved twice">
		<description>Opens Data Groups and saves a data group filled with generated test data twice, then deletes it.</description>
		<method>
			<navigateList document="DataGroup" module="admin" />
			<listGridNew document="DataGroup" module="admin" />
			<testDataEnter />
			<save />
			<testDataEnter />
			<save />
			<delete />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
