<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Admin suite (admin.suite.xml), SmartClient: Reports (the SmartClient-only Report Manager, Report Designer and Report Schedules), the
	SmartClient-only Snapshots and Tags, Audits, System Dashboard, Document Numbers and Jobs.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
		<switchMode />
	</before>
	<interaction name="Reports: the SmartClient menu has the report tools, not the Reports list">
		<method>
			<testMenu module="admin" item="Reports/Reports" present="false" />
			<navigateMenu module="admin" item="Reports/Report Manager" />
			<testWidget binding="currentReports" />
			<testWidget action="ExportReportSpecifications" />
			<navigateMenu module="admin" item="Reports/Report Designer" />
			<testGridRows module="admin" document="ReportTemplate" minRows="0" />
			<listGridNew module="admin" document="ReportTemplate" createView="true" />
			<testWidget binding="name" />
			<cancel />
			<navigateMenu module="admin" item="Reports/Report Schedules" />
			<testGridRows module="admin" query="qReportSchedules" minRows="0" />
		</method>
	</interaction>
	<interaction name="Snapshots">
		<method>
			<navigateMenu module="admin" item="Snapshots" />
			<tabSelect path="All Snapshots" />
			<testGridRows module="admin" query="qSnapshots" minRows="0" />
			<tabSelect path="Reorder Snapshots" />
			<testWidget action="Reorder" />
		</method>
	</interaction>
	<interaction name="Tags: create, every tab, delete">
		<method>
			<navigateMenu module="admin" item="Tags" />
			<listGridNew module="admin" document="Tag" />
			<tabSelect path="Details" />
			<dataEnter binding="name" value="SAIL Tag {run}" />
			<save />
			<testValue binding="name" value="SAIL Tag {run}" />
			<tabSelect path="Combinations" />
			<tabSelect path="Load" />
			<tabSelect path="Action" />
			<tabSelect path="Details" />
			<ok />
			<testGridRows module="admin" document="Tag" rowContaining="SAIL Tag {run}" minRows="1" maxRows="1" />
			<listGridZoom module="admin" document="Tag" rowContaining="SAIL Tag {run}" />
			<delete />
			<testGridRows module="admin" document="Tag" rowContaining="SAIL Tag {run}" maxRows="0" />
		</method>
	</interaction>
	<interaction name="Audits: the saves made by the suite are audited">
		<method>
			<navigateMenu module="admin" item="Audits" />
			<testWidget tab="Audits" />
			<tabSelect path="Audits" />
			<testGridRows module="admin" query="qAudits" minRows="1" />
			<listGridZoom module="admin" query="qAudits" row="0" />
			<cancel />
		</method>
	</interaction>
	<interaction name="System Dashboard">
		<method>
			<navigateMenu module="admin" item="System Dashboard" />
			<testGridRows binding="status" minRows="1" />
			<testGridRows module="admin" query="qDashboardJobs" minRows="1" />
		</method>
	</interaction>
	<interaction name="Document Numbers: create, find and delete">
		<method>
			<navigateMenu module="admin" item="Document Numbers" />
			<listGridNew module="admin" document="DocumentNumber" />
			<dataEnter binding="moduleName" value="sail" />
			<dataEnter binding="documentName" value="SAIL{run}" />
			<dataEnter binding="sequenceName" value="number" />
			<dataEnter binding="documentNumber" value="1000" />
			<save />
			<testValue binding="documentName" value="SAIL{run}" />
			<ok />
			<testGridRows module="admin" document="DocumentNumber" rowContaining="SAIL{run}" minRows="1" maxRows="1" />
			<listGridZoom module="admin" document="DocumentNumber" rowContaining="SAIL{run}" />
			<dataEnter binding="documentNumber" value="1001" />
			<save />
			<testValue binding="documentNumber" value="1001" />
			<delete />
			<testGridRows module="admin" document="DocumentNumber" rowContaining="SAIL{run}" maxRows="0" />
		</method>
	</interaction>
	<interaction name="Jobs: the backup job has completed">
		<method>
			<navigateMenu module="admin" item="Jobs" />
			<tabSelect path="Actual" />
			<action name="Refresh" />
			<testGridRows module="admin" query="qCompletedJobs" rowContaining="Backup" minRows="1" />
			<listGridZoom module="admin" query="qCompletedJobs" rowContaining="Backup" />
			<cancel />
			<tabSelect path="Schedule" />
			<comment>The schedule is read only: the test server runs without the job scheduler</comment>
		</method>
	</interaction>
	<interaction name="Document Numbers: generated data, from the document numbers query">
		<method>
			<comment>testDataEnter fills every field of the view with generated values (from the retired single-file admin script)</comment>
			<navigateList module="admin" query="qDocumentNumbers" />
			<listGridNew module="admin" query="qDocumentNumbers" />
			<testDataEnter />
			<save />
			<comment>Generated values again, saved over the first: an update of the saved record</comment>
			<testDataEnter />
			<save />
			<delete />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
