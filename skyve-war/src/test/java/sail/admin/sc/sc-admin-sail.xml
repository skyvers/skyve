<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<automation uxui="desktop" userAgentType="desktop"
	testStrategy="Assert"
	xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../main/java/schemas/sail.xsd"
	xmlns="http://www.skyve.org/xml/sail"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<interaction name="Login/Logout">
		<method>
			<login user="admin" password="admin" />
			<switchMode />
			<logout />
		</method>
	</interaction>
	<interaction name="LoginError">
		<method>
			<login user="badmin" password="badmin" />
			<testFailure />
			<login user="admin" password="admin" />
			<testSuccess />
			<switchMode />
		</method>
	</interaction>
	<!-- Changing admin's password to "admin" fails the password policy, and a real change would lock admin
		out of later runs. Changing a password moves to the phase-3 admin suite, which will use a throwaway user.
	<interaction name="Change password">
		<method>
			<navigateEdit module="admin" document="ChangePassword" />
			<dataEnter binding="oldPassword" value="admin" />
			<dataEnter binding="newPassword" value="admin" />
			<dataEnter binding="confirmPassword" value="admin" />
			<action name="MakePasswordChange" />
		</method>
	</interaction>
	-->
	<interaction name="Menu User Dashboard">
		<method>
			<navigateEdit module="admin" document="UserDashboard" />
			<testDataEnter />
			<action name="UpdateMyDetails" />
		</method>
	</interaction>
	<interaction name="Menu Contacts">
		<method>
			<navigateList module="admin" query="qContacts" />
			<listGridNew module="admin" query="qContacts" />
			<testDataEnter />
			<save />
			<testDataEnter />
			<save />
			<delete />
		</method>
	</interaction>
	<interaction name="Menu Communications">
		<method>
			<navigateList module="admin" query="qCommunications" />
			<listGridNew module="admin" query="qCommunications" />
			<testDataEnter />
			<tabSelect path="Contents" />
			<tabSelect path="Attachments" />
			<tabSelect path="Manage" />
			<save />
			<testDataEnter />
			<save />
			<tabSelect path="Contents" />
			<action name="AddUnsubscribeLink" />
			<tabSelect path="Attachments" />
			<tabSelect path="Manage" />
			<!-- Nothing is tagged (a fresh database has none), so the recipient actions refuse to run: assert that they say so.
				Tagging recipients and sending belong to the phase-3 admin suite. -->
			<action name="GetCount" testSuccess="false" />
			<testFailure message="A tag must be selected" />
			<action name="TestSend" confirm="true" testSuccess="false" />
			<testFailure message="There are no tagged items" />
			<action name="GetResults" testSuccess="false" />
			<testFailure message="A tag must be selected" />
			<action name="CreateFiles" confirm="true" testSuccess="false" />
			<testFailure message="A tag must be selected" />
			<action name="SendNow" confirm="true" testSuccess="false" />
			<testFailure message="A tag must be selected" />
			<tabSelect path="Subscriptions" />
			<delete />
		</method>
	</interaction>
	<interaction name="Menu Security Admin::Groups">
		<method>
			<navigateList document="Group" module="admin" />
			<listGridNew document="Group" module="admin" />
			<testDataEnter />
			<!-- A group needs at least one role to save, and roles are a list membership, which no SAIL op-code
				drives yet (a phase 2 language need). Assign the first candidate role through SmartClient. -->
			<execute><![CDATA[var s = isc.WindowStack._stack; var v = s.length ? s[s.length - 1].items[0] : isc.BizUtil.getCurrentView(); var g = v._grids.roles; var m = g[Object.keys(g)[0]]; m._candidateList.selectSingleRecord(0); m._memberList.transferSelectedData(m._candidateList); v._vm.setValue('_changed', true); v._vm.setValue('_apply', true); if (m.changed) m.changed();]]></execute>
			<tabSelect path="Group Details" />
			<tabSelect path="Users in Group" />
			<save />
			<testDataEnter />
			<save />
			<tabSelect path="Group Details" />
			<tabSelect path="Users in Group" />
			<!-- delete rather than cancel, so that repeated runs do not leave groups behind -->
			<delete />
		</method>
	</interaction>
	<interaction name="Menu Security Admin::Data Groups">
		<method>
			<navigateList document="DataGroup" module="admin" />
			<listGridNew document="DataGroup" module="admin" />
			<testDataEnter />
			<save />
			<testDataEnter />
			<save />
			<delete />
		</method>
	</interaction>
	<interaction name="Menu DevOps::Data Maintenance">
		<method>
			<navigateEdit document="DataMaintenance" module="admin" />
			<listGridNew query="qImportExport" />
			<cancel/>
			<tabSelect path="Data"/>
			<tabSelect path="Content" />
			<tabSelect path="Manage Audits" />
			<tabSelect path="Data Refresh" />
		</method>
	</interaction>
	<interaction name="Menu DevOps::Document Creator">
		<method>
			<navigateEdit document="DocumentCreator" module="admin" />
			<tabSelect path="Input" />
			<tabSelect path="Markdown Preview" />
			<tabSelect path="Document Preview" />
			<tabSelect path="Help" />
			<tabSelect path="Input" />
			<tabSelect path="Markdown Preview" />
			<tabSelect path="Document Preview" />
			<tabSelect path="Help" />
			<!-- No script or output location has been entered, so Submit must refuse to run. -->
			<action name="Submit" confirm="true" testSuccess="false" />
			<testFailure message="Output location is required" />
		</method>
	</interaction>
	<interaction name="Menu System Dashboard">
		<method>
			<navigateEdit document="SystemDashboard" module="admin" />
			<testDataEnter />
		</method>
	</interaction>
	<interaction name="Menu Document Numbers">
		<method>
			<navigateList module="admin" query="qDocumentNumbers" />
			<listGridNew module="admin" query="qDocumentNumbers" />
			<testDataEnter />
			<save />
			<testDataEnter />
			<save />
			<delete />
		</method>
	</interaction>
	<interaction name="Menu Jobs">
		<method>
			<navigateEdit document="Jobs" module="admin" />
			<testDataEnter />
			<tabSelect path="Actual" />
			<tabSelect path="Schedule" />
			<tabSelect path="Actual" />
			<tabSelect path="Schedule" />
			<action name="Refresh" />
			<action name="DeleteCompletedJobs" confirm="true" />
		</method>
	</interaction>
</automation>