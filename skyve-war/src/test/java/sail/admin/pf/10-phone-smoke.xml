<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Admin suite (admin.suite.xml), PrimeFaces phone: open each admin menu item the phone UX/UI shows, through the menu. The suite runs it in a phone browser (its userAgentType). -->
<automation uxui="phone" userAgentType="phone" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Signs in as admin in PrimeFaces on a phone and checks that the phone menu hides the desktop-only items and opens every item it does show.</description>
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
	</before>
	<interaction name="Phone menu">
		<description>Checks Data Groups and Document Creator are missing from the phone menu, then opens each menu item the phone offers, checking a few of the screens show their fields or rows.</description>
		<method>
			<comment>Desktop, external and tablet only</comment>
			<testMenu module="admin" item="Security Admin/Data Groups" present="false" />
			<testMenu module="admin" item="DevOps/DocumentCreator" present="false" />
			<navigateMenu module="admin" item="Password" />
			<testWidget binding="oldPassword" />
			<navigateMenu module="admin" item="Contacts" />
			<testGridRows module="admin" document="Contact" minRows="1" />
			<navigateMenu module="admin" item="Communication/Communications" />
			<navigateMenu module="admin" item="Communication/Communication Templates" />
			<navigateMenu module="admin" item="Security Admin/Groups" />
			<navigateMenu module="admin" item="Security Admin/Users" />
			<testWidget tab="Users" />
			<navigateMenu module="admin" item="Security Admin/Configuration" />
			<navigateMenu module="admin" item="Security Admin/Sign In History" />
			<testGridRows module="admin" query="qLoginHistory" minRows="1" />
			<navigateMenu module="admin" item="DevOps/Control Panel" />
			<navigateMenu module="admin" item="DevOps/Data Maintenance" />
			<navigateMenu module="admin" item="DevOps/Monitoring Dashboard" />
			<navigateMenu module="admin" item="Document Numbers" />
			<navigateMenu module="admin" item="Jobs" />
			<testSuccess />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
