<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Admin suite (admin.suite.xml), PrimeFaces: signing in and out, and the home page (User Dashboard). -->
<automation uxui="tablet" userAgentType="tablet" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
	</before>
	<interaction name="Home: User Dashboard">
		<method>
			<navigateEdit module="admin" document="UserDashboard" />
			<testValue binding="currentUser.userName" value="admin" />
			<testWidget binding="currentUser.userName" enabled="false" />
			<testWidget action="UpdateMyDetails" enabled="true" />
			<dataEnter binding="currentUser.contact.mobile" value="0400 000 {run}" />
			<testValue binding="currentUser.contact.mobile" value="0400 000 {run}" />
			<action name="UpdateMyDetails" />
			<navigateEdit module="admin" document="UserDashboard" />
			<testValue binding="currentUser.contact.mobile" value="0400 000 {run}" />
		</method>
	</interaction>
	<interaction name="Sign in, out, and with a bad password">
		<method>
			<login user="admin" password="not the password" />
			<testFailure message="Invalid username and/or password" />
			<login user="nobody{run}" password="admin" />
			<testFailure />
			<login user="admin" password="admin" />
			<testSuccess />
			<testMenu module="admin" />
			<testMenu module="admin" item="Contacts" />
			<logout />
			<login user="admin" password="admin" />
			<testSuccess />
		</method>
	</interaction>
	<interaction name="Home: Update My Details after those sign ins">
		<method>
			<comment>Runtime issue P4: Update My Details was reported to fail with an optimistic lock after sign ins, good and bad</comment>
			<navigateEdit module="admin" document="UserDashboard" />
			<dataEnter binding="currentUser.contact.mobile" value="0400 001 {run}" />
			<action name="UpdateMyDetails" />
			<navigateEdit module="admin" document="UserDashboard" />
			<testValue binding="currentUser.contact.mobile" value="0400 001 {run}" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
