<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	PrimeFaces admin suite: DevOps. Control Panel, Data Maintenance, Document Creator and Monitoring Dashboard, with their
	safe actions. The destructive ones run in 98-destructive.xml.
-->
<automation uxui="tablet" userAgentType="tablet" testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<before>
		<login user="admin" password="admin" />
		<testSuccess />
	</before>
	<interaction name="Control Panel: every tab, a query, cache statistics and generated SAIL">
		<method>
			<navigateMenu module="admin" item="DevOps/Control Panel" />
			<tabSelect path="Design" />
			<dataEnter binding="query" value="select bean from {admin.Contact} as bean" />
			<action name="ExecuteQuery" />
			<tabSelect path="Design" />
			<action name="CacheStats" />
			<tabSelect path="SAIL" />
			<lookupDescriptionAutoComplete binding="sailUser" search="admin" />
			<action name="GenerateMenuSAIL" testSuccess="false" />
			<tabSelect path="Results" />
			<tabSelect path="Instrumentation" />
			<comment>A server-wide trace flag: switch it on and back off</comment>
			<testWidget binding="queryTrace" enabled="true" />
			<dataEnter binding="queryTrace" value="true" />
			<testValue binding="queryTrace" value="true" />
			<dataEnter binding="queryTrace" value="false" />
			<testValue binding="queryTrace" value="false" />
			<tabSelect path="User Remember-Me Tokens" />
			<tabSelect path="Design" />
		</method>
	</interaction>
	<interaction name="Data Maintenance: every tab, the backup list and import/export">
		<method>
			<navigateMenu module="admin" item="DevOps/Data Maintenance" />
			<tabSelect path="Import/Export" />
			<tabSelect path="Backup/Restore" />
			<action name="RefreshBackupList" />
			<testGridRows module="admin" query="BackupsModel" minRows="1" />
			<comment>Delete, Download and Restore need a backup selected</comment>
			<testWidget action="DeleteBackup" enabled="false" />
			<listGridSelect module="admin" query="BackupsModel" row="0" />
			<testWidget action="DeleteBackup" enabled="true" />
			<testWidget action="Restore" enabled="true" />
			<tabSelect path="Data Refresh" />
			<testGridRows binding="refreshDocuments" minRows="1" />
			<tabSelect path="Import/Export" />
			<listGridNew module="admin" query="qImportExport" />
			<testWidget binding="mode" />
			<cancel />
		</method>
	</interaction>
	<interaction name="Document Creator: write a script and preview it">
		<method>
			<navigateMenu module="admin" item="DevOps/DocumentCreator" />
			<tabSelect path="Input" />
			<dataEnter binding="script" value="# SAIL{run}" />
			<tabSelect path="Markdown Preview" />
			<tabSelect path="Document Preview" />
			<tabSelect path="Help" />
			<tabSelect path="Input" />
			<testValue binding="script" value="# SAIL{run}" />
		</method>
	</interaction>
	<interaction name="Monitoring Dashboard: charts and requests">
		<method>
			<navigateMenu module="admin" item="DevOps/Monitoring Dashboard" />
			<tabSelect path="Charts" />
			<!--
				LANGUAGE NEED: every Refresh button is inside a collapsible box that starts closed, and SAIL has no step to open
				a box, so a user's click on Refresh cannot be scripted. Add Refresh back once there is one.
			<action name="Refresh" />
			-->
			<tabSelect path="Requests" />
			<testGridRows module="admin" query="RequestListModel" minRows="1" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
