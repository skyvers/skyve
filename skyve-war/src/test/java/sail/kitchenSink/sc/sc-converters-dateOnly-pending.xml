<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	SmartClient date time and timestamp attributes whose converters show only the date (*_DateTime, *_Timestamp), which
	SmartClient types as dates: its edit form sends 2026-06-05, which the server cannot read as a date time, so a save
	with a value fails ("A problem was encountered"); and its list filter compares with midnight UTC of the typed day,
	exactly. These steps fail until that is fixed (pending a decision; see the converters decision log), so no IT runs
	them yet: SmartClientConvertersSailIT.dateOnly is disabled.
	PrimeFaces makes records a, b and c (its date-only pickers save the day at midnight, local time), then SmartClient
	enters a record d and filters the list by each column, under Verify so that every failure is listed.
-->
<workflow xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<automation uxui="external" userAgentType="desktop" testStrategy="Assert">
		<before>
			<login user="admin" password="admin" />
		</before>
		<interaction name="PrimeFaces: record a">
			<method>
				<navigateList module="kitchensink" query="qConvertersDateOnly" />
				<listGridNew module="kitchensink" query="qConvertersDateOnly" />
				<dataEnter binding="name" value="SAIL dateOnly {run} a" />
				<dataEnter binding="ddMmYyyyDateTime" value="05/06/2026" />
				<dataEnter binding="ddMmmYyyyDateTime" value="05-Jun-2026" />
				<dataEnter binding="mmDdYyyyDateTime" value="06/05/2026" />
				<dataEnter binding="mmmDdYyyyDateTime" value="Jun-05-2026" />
				<dataEnter binding="yyyyMmDdDateTime" value="2026/06/05" />
				<dataEnter binding="ddMmYyyyTimestamp" value="05/06/2026" />
				<dataEnter binding="ddMmmYyyyTimestamp" value="05-Jun-2026" />
				<dataEnter binding="mmDdYyyyTimestamp" value="06/05/2026" />
				<dataEnter binding="mmmDdYyyyTimestamp" value="Jun-05-2026" />
				<dataEnter binding="yyyyMmDdTimestamp" value="2026/06/05" />
				<save />
				<testSuccess />
				<ok />
			</method>
		</interaction>
		<interaction name="PrimeFaces: record b">
