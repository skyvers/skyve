				<dataEnter binding="mmDdYyyyDateTime" value="05/06/2026" />
				<dataEnter binding="mmmDdYyyyDateTime" value="May-06-2026" />
				<dataEnter binding="yyyyMmDdDateTime" value="2026/05/06" />
				<dataEnter binding="ddMmYyyyTimestamp" value="06/05/2026" />
				<dataEnter binding="ddMmmYyyyTimestamp" value="06-May-2026" />
				<dataEnter binding="mmDdYyyyTimestamp" value="05/06/2026" />
				<dataEnter binding="mmmDdYyyyTimestamp" value="May-06-2026" />
				<dataEnter binding="yyyyMmDdTimestamp" value="2026/05/06" />
