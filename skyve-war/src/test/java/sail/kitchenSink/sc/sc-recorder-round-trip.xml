<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	The kitchen sink workflow that SmartClientRecorderRoundTripSailIT records and replays. It uses only the gestures
	recorder phase 1 maps (menus, URLs, data entry, tabs, actions and list grids), and has no login: it runs in a session
	that is already signed in and recording.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
	xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
	xmlns="http://www.skyve.org/xml/sail"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Used by the recorder round-trip test: a user in an already signed-in SmartClient (desktop UX/UI) session makes a lookup value, fills in the Kitchen Sink widgets, runs actions and opens a list grid row, while the recorder writes a script of what was done, which is then replayed.</description>
	<interaction name="Lookup values">
		<description>Creates a lookup value, opens it again from the Lookup values list and checks its description.</description>
		<method>
			<navigateMenu module="kitchensink" item="Lookup values" />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="SAIL Recorded {run}" />
			<save />
			<ok />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="SAIL Recorded {run}" />
			<testValue binding="description" value="SAIL Recorded {run}" />
			<cancel />
		</method>
	</interaction>
	<interaction name="Widgets">
		<description>Fills in every kind of Kitchen Sink widget (checkbox, colour, dates, number, combo, radio, spinner, slider, text, memo, time, timestamp and markup) and checks the combo and text values.</description>
		<method>
			<navigateEdit module="kitchensink" document="KitchenSink" />
			<dataEnter binding="booleanFlag" value="true" />
			<dataEnter binding="colour" value="#000000" />
			<dataEnter binding="date" value="07-Nov-2025" />
			<dataEnter binding="dateTime" value="07-Nov-2025 15:38" />
			<dataEnter binding="decimal2" value="0.25" />
			<dataEnter binding="combo" value="1" />
			<dataEnter binding="radio" value="2" />
			<dataEnter binding="normalInteger" value="1" />
			<dataEnter binding="spinner" value="5" />
			<dataEnter binding="slider" value="7" />
			<dataEnter binding="text" value="Sample text {run}" />
			<dataEnter binding="memo" value="First line&#10;Second line" />
			<dataEnter binding="time" value="11:11" />
			<dataEnter binding="timestamp" value="07-Nov-2025 15:43:16" />
			<dataEnter binding="markup" value="Test paragraph" />
			<testValue binding="combo" value="one" />
			<testValue binding="text" value="Sample text {run}" />
			<comment>A menu click is the next gesture, so the entries above are recorded before it</comment>
			<navigateMenu module="kitchensink" item="Kitchen Sink" />
		</method>
	</interaction>
	<interaction name="Actions and tabs">
		<description>Runs the Actions Fixture's toolbar, form button and tab button actions, checking the outcome each time.</description>
		<method>
			<navigateEdit module="kitchensink" document="ActionsFixture" />
			<action name="RunFromToolbar" />
			<testValue binding="outcome" value="Run From Toolbar ran" />
			<action name="RunFromFormButton" />
			<comment>Tab button is the first tab: select another first, as selecting the shown tab does nothing</comment>
			<tabSelect path="Rows" />
			<tabSelect path="Tab button" />
			<action name="RunFromTabButton" />
			<testValue binding="outcome" value="Run From Tab Button ran" />
		</method>
	</interaction>
	<interaction name="List grid in a view">
		<description>Makes a Model Lookup Fixture, opens it from the list grid in its view and deletes it.</description>
		<method>
			<navigateEdit module="kitchensink" document="ModelLookupFixture" />
			<dataEnter binding="name" value="SAIL recorded lookup {run}" />
			<save />
			<listGridZoom module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL recorded lookup {run}" />
			<testValue binding="name" value="SAIL recorded lookup {run}" />
			<delete />
		</method>
	</interaction>
</automation>
