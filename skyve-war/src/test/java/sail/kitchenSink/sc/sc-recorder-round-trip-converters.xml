<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	The converters workflow that SmartClientRecorderRoundTripSailIT records and replays: data entry and list grid
	filters (the filter row, and the advanced filter for lessThan) on dates, times and numbers whose converters are not
	the defaults (the Converters Fixtures list, kitchensink.ConvertersFixture): a month name date, a month first 12 hour
	date time, a timestamp with a month name and seconds, a 12 hour time at noon, dollars and two percentages. Each
	filter value is written as the column's cells show it, which is also how it was typed, so that the recorder writes
	it as typed (a value the application showed but the user did not type would be recorded as a capture). It has no
	login: it runs in a session that is already signed in and recording. The fixture it makes sorts first ("0 ...") and
	is deleted again at the end.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
	xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
	xmlns="http://www.skyve.org/xml/sail"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<interaction name="Converters: entry, then the list's filters as the cells show the values">
		<method>
			<navigateMenu module="kitchensink" item="Converters Fixtures" />
			<listGridNew module="kitchensink" document="ConvertersFixture" />
			<dataEnter binding="name" value="0 SAIL converters {run}" />
			<dataEnter binding="mmmDdYyyy" value="Jun-05-2026" />
			<dataEnter binding="mmDdYyyyHhMi" value="06/05/2026 02:47 PM" />
			<dataEnter binding="ddMmmYyyyHhMiSs" value="25-Dec-2026 12:00:59 AM" />
			<dataEnter binding="hhMi" value="12:00 PM" />
			<dataEnter binding="decimal2DollarsAndCents" value="1,234.56" />
			<dataEnter binding="decimal5TwoDecimalPlacesPercentage" value="12.50%" />
			<dataEnter binding="simplePercentage" value="-5%" />
			<save />
			<testValue binding="decimal2DollarsAndCents" value="1,234.56" />
			<ok />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="name" value="{run}" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="mmmDdYyyy" value="Jun-05-2026" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="mmDdYyyyHhMi" value="06/05/2026 02:47 PM" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="ddMmmYyyyHhMiSs" value="25-Dec-2026 12:00:59 AM" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="hhMi" value="12:00 PM" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="decimal2DollarsAndCents" value="1,234.56" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="decimal5TwoDecimalPlacesPercentage" value="12.50%" operator="equals" />
			<listGridFilter module="kitchensink" document="ConvertersFixture" column="simplePercentage" value="0%" operator="lessThan" />
			<testGridRows module="kitchensink" document="ConvertersFixture" rowContaining="0 SAIL converters {run}" minRows="1" maxRows="1" />
			<listGridZoom module="kitchensink" document="ConvertersFixture" rowContaining="0 SAIL converters {run}" />
			<delete />
			<listGridClearFilter module="kitchensink" document="ConvertersFixture" />
		</method>
	</interaction>
</automation>
