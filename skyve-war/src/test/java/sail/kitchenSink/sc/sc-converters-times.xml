<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	SmartClient SAIL conformance for converters: times (kitchensink.ConvertersFixture, an attribute per converter).
	Records a, b and c (and d and e for the duration) are typed into each field, and into an inline grid row with the
	next record's values, then checked with testValue after the save and once reopened from the list. Then each
	column of the list view's grid is filtered with values written as the cells show them, and the rows each filter
	leaves are checked. The values catch day and month swapped, 12 hour times at PM, noon and midnight, month names,
	seconds, negatives, separators, $, percentages (over 1000% too), rounding, durations rounded to the minute, and
	the absolute converter of a stored negative. Equals compares the stored value exactly, so a value shown rounded is
	not filtered by what it shows.
	A member of converters.suite.xml (ConvertersSuiteSailIT).
-->
<automation uxui="desktop"
			userAgentType="desktop"
			testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Signs in as admin in SmartClient (desktop UX/UI) and checks that times in 12 and 24 hour formats, with and without seconds are shown, typed, saved and filtered in the format each field uses. It types records into the fields and an inline grid row, checks the values as saved and after reopening, then filters the list by each column as its cells show the values.</description>
	<before>
		<login user="admin" password="admin" />
		<switchMode />
	</before>
	<interaction name="Times: record a, in each field and an inline grid row, checked when saved and reopened">
		<description>Makes a Converters Fixture record whose time fields hold 2:47 PM, and adds an inline grid row with the next record's values. Saves it, and checks every value reads back as saved and again after reopening the record from the list.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersTimes" />
			<listGridNew module="kitchensink" query="qConvertersTimes" />
			<dataEnter binding="name" value="SAIL times {run} a" />
			<dataEnter binding="hhMi" value="02:47 PM" />
			<dataEnter binding="hh24Mi" value="14:47" />
			<dataEnter binding="hhMiSs" value="02:47:25 PM" />
			<dataEnter binding="hh24MiSs" value="14:47:25" />
			<comment>An inline grid row: its cells take the next record's values, so that they differ from the fields'</comment>
			<dataGridNew binding="timeRows" />
			<dataEnter binding="hhMi" value="12:00 PM" />
			<dataEnter binding="hh24Mi" value="12:00" />
			<dataEnter binding="hhMiSs" value="12:00:00 PM" />
			<dataEnter binding="hh24MiSs" value="12:00:00" />
			<save />
			<testSuccess />
			<testValue binding="hhMi" value="02:47 PM" />
			<testValue binding="hh24Mi" value="14:47" />
			<testValue binding="hhMiSs" value="02:47:25 PM" />
			<testValue binding="hh24MiSs" value="14:47:25" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="12:00 PM" />
			<testValue binding="hh24Mi" value="12:00" />
			<testValue binding="hhMiSs" value="12:00:00 PM" />
			<testValue binding="hh24MiSs" value="12:00:00" />
			<ok />
			<comment>Reopened from the list</comment>
			<listGridZoom module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" />
			<testValue binding="hhMi" value="02:47 PM" />
			<testValue binding="hh24Mi" value="14:47" />
			<testValue binding="hhMiSs" value="02:47:25 PM" />
			<testValue binding="hh24MiSs" value="14:47:25" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="12:00 PM" />
			<testValue binding="hh24Mi" value="12:00" />
			<testValue binding="hhMiSs" value="12:00:00 PM" />
			<testValue binding="hh24MiSs" value="12:00:00" />
			<cancel />
		</method>
	</interaction>
	<interaction name="Times: record b, in each field and an inline grid row, checked when saved and reopened">
		<description>Makes a Converters Fixture record whose time fields hold noon, and adds an inline grid row with the next record's values. Saves it, and checks every value reads back as saved and again after reopening the record from the list.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersTimes" />
			<listGridNew module="kitchensink" query="qConvertersTimes" />
			<dataEnter binding="name" value="SAIL times {run} b" />
			<dataEnter binding="hhMi" value="12:00 PM" />
			<dataEnter binding="hh24Mi" value="12:00" />
			<dataEnter binding="hhMiSs" value="12:00:00 PM" />
			<dataEnter binding="hh24MiSs" value="12:00:00" />
			<comment>An inline grid row: its cells take the next record's values, so that they differ from the fields'</comment>
			<dataGridNew binding="timeRows" />
			<dataEnter binding="hhMi" value="12:00 AM" />
			<dataEnter binding="hh24Mi" value="00:00" />
			<dataEnter binding="hhMiSs" value="12:00:59 AM" />
			<dataEnter binding="hh24MiSs" value="00:00:59" />
			<save />
			<testSuccess />
			<testValue binding="hhMi" value="12:00 PM" />
			<testValue binding="hh24Mi" value="12:00" />
			<testValue binding="hhMiSs" value="12:00:00 PM" />
			<testValue binding="hh24MiSs" value="12:00:00" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="12:00 AM" />
			<testValue binding="hh24Mi" value="00:00" />
			<testValue binding="hhMiSs" value="12:00:59 AM" />
			<testValue binding="hh24MiSs" value="00:00:59" />
			<ok />
			<comment>Reopened from the list</comment>
			<listGridZoom module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} b" />
			<testValue binding="hhMi" value="12:00 PM" />
			<testValue binding="hh24Mi" value="12:00" />
			<testValue binding="hhMiSs" value="12:00:00 PM" />
			<testValue binding="hh24MiSs" value="12:00:00" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="12:00 AM" />
			<testValue binding="hh24Mi" value="00:00" />
			<testValue binding="hhMiSs" value="12:00:59 AM" />
			<testValue binding="hh24MiSs" value="00:00:59" />
			<cancel />
		</method>
	</interaction>
	<interaction name="Times: record c, in each field and an inline grid row, checked when saved and reopened">
		<description>Makes a Converters Fixture record whose time fields hold midnight, with 59 seconds, and adds an inline grid row with the next record's values. Saves it, and checks every value reads back as saved and again after reopening the record from the list.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersTimes" />
			<listGridNew module="kitchensink" query="qConvertersTimes" />
			<dataEnter binding="name" value="SAIL times {run} c" />
			<dataEnter binding="hhMi" value="12:00 AM" />
			<dataEnter binding="hh24Mi" value="00:00" />
			<dataEnter binding="hhMiSs" value="12:00:59 AM" />
			<dataEnter binding="hh24MiSs" value="00:00:59" />
			<comment>An inline grid row: its cells take the next record's values, so that they differ from the fields'</comment>
			<dataGridNew binding="timeRows" />
			<dataEnter binding="hhMi" value="02:47 PM" />
			<dataEnter binding="hh24Mi" value="14:47" />
			<dataEnter binding="hhMiSs" value="02:47:25 PM" />
			<dataEnter binding="hh24MiSs" value="14:47:25" />
			<save />
			<testSuccess />
			<testValue binding="hhMi" value="12:00 AM" />
			<testValue binding="hh24Mi" value="00:00" />
			<testValue binding="hhMiSs" value="12:00:59 AM" />
			<testValue binding="hh24MiSs" value="00:00:59" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="02:47 PM" />
			<testValue binding="hh24Mi" value="14:47" />
			<testValue binding="hhMiSs" value="02:47:25 PM" />
			<testValue binding="hh24MiSs" value="14:47:25" />
			<ok />
			<comment>Reopened from the list</comment>
			<listGridZoom module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" />
			<testValue binding="hhMi" value="12:00 AM" />
			<testValue binding="hh24Mi" value="00:00" />
			<testValue binding="hhMiSs" value="12:00:59 AM" />
			<testValue binding="hh24MiSs" value="00:00:59" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="timeRows" row="0" />
			<testValue binding="hhMi" value="02:47 PM" />
			<testValue binding="hh24Mi" value="14:47" />
			<testValue binding="hhMiSs" value="02:47:25 PM" />
			<testValue binding="hh24MiSs" value="14:47:25" />
			<cancel />
		</method>
	</interaction>
	<interaction name="Times: filter the list grid by each column, as its cells show the values">
		<description>Filters the list grid of Converters Fixtures by each time column, typed as the cells show the values, with equals, less than and greater than, and checks which of the run's records each filter leaves.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersTimes" />
			<listGridClearFilter module="kitchensink" query="qConvertersTimes" />
			<comment>Only this run's records</comment>
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="name" value="{run}" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="3" maxRows="3" />
			<comment>Each record's cells show its values as the converters write them</comment>
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="02:47 PM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00 PM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00 AM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="14:47" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="00:00" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="02:47:25 PM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00:00 PM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00:59 AM" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="14:47:25" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00:00" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="00:00:59" minRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMi" value="12:00 PM" operator="equals" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} b" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00 PM" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMi" value="12:00 PM" operator="notEquals" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="2" maxRows="2" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMi" value="12:00 PM" operator="lessThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMi" value="12:00 PM" operator="greaterThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMi" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24Mi" value="12:00" operator="equals" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} b" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24Mi" value="12:00" operator="lessThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24Mi" value="12:00" operator="greaterThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24Mi" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMiSs" value="12:00:00 PM" operator="equals" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} b" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00:00 PM" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMiSs" value="12:00:00 PM" operator="lessThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMiSs" value="12:00:00 PM" operator="greaterThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hhMiSs" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24MiSs" value="12:00:00" operator="equals" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} b" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="12:00:00" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24MiSs" value="12:00:00" operator="lessThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} c" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24MiSs" value="12:00:00" operator="greaterThan" />
			<testGridRows module="kitchensink" query="qConvertersTimes" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersTimes" rowContaining="SAIL times {run} a" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersTimes" column="hh24MiSs" />
			<listGridClearFilter module="kitchensink" query="qConvertersTimes" />
		</method>
	</interaction>
	<after>
		<logout />
	</after>
</automation>
