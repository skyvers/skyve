	<interaction name="Dates: filter the list grid by each column, as its cells show the values">
		<description>Filters the list grid of Converters Fixtures by each date column, typed as the cells show the values, with equals, less than and greater than, and checks which of the run's records each filter leaves.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersDates" />
			<listGridClearFilter module="kitchensink" query="qConvertersDates" />
			<comment>Only this run's records</comment>
			<listGridFilter module="kitchensink" query="qConvertersDates" column="name" value="{run}" />
			<testGridRows module="kitchensink" query="qConvertersDates" minRows="3" maxRows="3" />
			<comment>Each record's cells show its values as the converters write them</comment>
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="05/06/2026" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="06/05/2026" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="25/12/2026" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="05-Jun-2026" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="06-May-2026" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="25-Dec-2026" minRows="1" />
