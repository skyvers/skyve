			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="2026/05/06" minRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="2026/12/25" minRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersDates" column="ddMmYyyy" value="05/06/2026" operator="equals" />
			<testGridRows module="kitchensink" query="qConvertersDates" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="SAIL dates {run} a" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="05/06/2026" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" query="qConvertersDates" column="ddMmYyyy" value="05/06/2026" operator="notEquals" />
			<testGridRows module="kitchensink" query="qConvertersDates" minRows="2" maxRows="2" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="SAIL dates {run} b" minRows="1" maxRows="1" />
			<testGridRows module="kitchensink" query="qConvertersDates" rowContaining="SAIL dates {run} c" minRows="1" maxRows="1" />
