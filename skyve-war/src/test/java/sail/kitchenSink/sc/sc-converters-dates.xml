<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	SmartClient SAIL conformance for converters: dates (kitchensink.ConvertersFixture, an attribute per converter).
	Records a, b and c (and d and e for the duration) are typed into each field, and into an inline grid row with the
	next record's values, then checked with testValue after the save and once reopened from the list. Then each
	column of the list view's grid is filtered with values written as the cells show them, and the rows each filter
	leaves are checked. The values catch day and month swapped, 12 hour times at PM, noon and midnight, month names,
	seconds, negatives, separators, $, percentages (over 1000% too), rounding, durations rounded to the minute, and
	the absolute converter of a stored negative. Equals compares the stored value exactly, so a value shown rounded is
	not filtered by what it shows.
	A member of converters.suite.xml (ConvertersSuiteSailIT).
-->
<automation uxui="desktop"
			userAgentType="desktop"
			testStrategy="Assert"
			xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
			xmlns="http://www.skyve.org/xml/sail"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Signs in as admin in SmartClient (desktop UX/UI) and checks that dates written day first, month first, with month names and year first are shown, typed, saved and filtered in the format each field uses. It types records into the fields and an inline grid row, checks the values as saved and after reopening, then filters the list by each column as its cells show the values.</description>
	<before>
		<login user="admin" password="admin" remember="true" />
		<switchMode />
	</before>
	<interaction name="Dates: record a, in each field and an inline grid row, checked when saved and reopened">
		<description>Makes a Converters Fixture record whose date fields hold 5 June 2026, which reads differently with the day and month swapped, and adds an inline grid row with the next record's values. Saves it, and checks every value reads back as saved and again after reopening the record from the list.</description>
		<method>
			<navigateList module="kitchensink" query="qConvertersDates" />
			<listGridNew module="kitchensink" query="qConvertersDates" />
			<dataEnter binding="name" value="SAIL dates {run} a" />
			<dataEnter binding="ddMmYyyy" value="05/06/2026" />
			<dataEnter binding="ddMmmYyyy" value="05-Jun-2026" />
			<dataEnter binding="mmDdYyyy" value="06/05/2026" />
			<dataEnter binding="mmmDdYyyy" value="Jun-05-2026" />
			<dataEnter binding="yyyyMmDd" value="2026/06/05" />
			<comment>An inline grid row: its cells take the next record's values, so that they differ from the fields'</comment>
			<dataGridNew binding="dateRows" />
			<dataEnter binding="ddMmYyyy" value="06/05/2026" />
			<dataEnter binding="ddMmmYyyy" value="06-May-2026" />
			<dataEnter binding="mmDdYyyy" value="05/06/2026" />
			<dataEnter binding="mmmDdYyyy" value="May-06-2026" />
			<dataEnter binding="yyyyMmDd" value="2026/05/06" />
			<save />
			<testSuccess />
			<testValue binding="ddMmYyyy" value="05/06/2026" />
			<testValue binding="ddMmmYyyy" value="05-Jun-2026" />
			<testValue binding="mmDdYyyy" value="06/05/2026" />
			<testValue binding="mmmDdYyyy" value="Jun-05-2026" />
			<testValue binding="yyyyMmDd" value="2026/06/05" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="dateRows" row="0" />
			<testValue binding="ddMmYyyy" value="06/05/2026" />
			<testValue binding="ddMmmYyyy" value="06-May-2026" />
			<testValue binding="mmDdYyyy" value="05/06/2026" />
			<testValue binding="mmmDdYyyy" value="May-06-2026" />
			<testValue binding="yyyyMmDd" value="2026/05/06" />
			<ok />
			<comment>Reopened from the list</comment>
			<listGridZoom module="kitchensink" query="qConvertersDates" rowContaining="SAIL dates {run} a" />
			<testValue binding="ddMmYyyy" value="05/06/2026" />
			<testValue binding="ddMmmYyyy" value="05-Jun-2026" />
			<testValue binding="mmDdYyyy" value="06/05/2026" />
			<testValue binding="mmmDdYyyy" value="Jun-05-2026" />
			<testValue binding="yyyyMmDd" value="2026/06/05" />
			<comment>The saved row's cells</comment>
			<dataGridEdit binding="dateRows" row="0" />
			<testValue binding="ddMmYyyy" value="06/05/2026" />
			<testValue binding="ddMmmYyyy" value="06-May-2026" />
			<testValue binding="mmDdYyyy" value="05/06/2026" />
			<testValue binding="mmmDdYyyy" value="May-06-2026" />
			<testValue binding="yyyyMmDd" value="2026/05/06" />
			<cancel />
		</method>
	</interaction>
