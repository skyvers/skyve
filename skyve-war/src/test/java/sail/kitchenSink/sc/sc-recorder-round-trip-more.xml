<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	The second kitchen sink workflow that SmartClientRecorderRoundTripSailIT records and replays: the gestures recorder
	phase 5 maps. Data grids (new, zoom, inline edits, select, remove, a drag and a link in a row), lookups (pick,
	autocomplete, new and edit, and in an inline grid), uploads (refused and accepted), list filters, sorting and
	selection, a number the application generates and the list is then filtered by (a capture), filters on dates and
	times as their columns show them (each column's converter), and server-side questions, and tree, map and calendar
	menu items. It has no login: it runs in a session that is already signed in and recording.
	The lookup values it makes sort first ("0 ...") and are deleted again at the end.
-->
<automation uxui="desktop" userAgentType="desktop" testStrategy="Assert"
	xsi:schemaLocation="http://www.skyve.org/xml/sail ../../../../main/java/schemas/sail.xsd"
	xmlns="http://www.skyve.org/xml/sail"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<description>Used by the recorder round-trip test: in an already signed-in SmartClient (desktop UX/UI) session, a user works with data grids, lookups, uploads, list filters and sorts, selection, server questions and tree, map and calendar items, while the recorder writes a script of what was done, which is then replayed.</description>
	<interaction name="Lookup values: a generated number, list filters and sorting">
		<description>Makes two lookup values, keeps the number of the first, filters the list by description and by that number, sorts by description, opens one row and clears the filters.</description>
		<method>
			<navigateMenu module="kitchensink" item="Lookup values" />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="0 SAIL lookup {run} a" />
			<save />
			<captureValue binding="number" variable="a" />
			<ok />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="0 SAIL lookup {run} b" />
			<save />
			<ok />
			<listGridFilter module="kitchensink" document="LookupDescription" column="description" value="{run}" />
			<listGridFilter module="kitchensink" document="LookupDescription" column="number" value="{var:a}" operator="equals" />
			<testGridRows module="kitchensink" document="LookupDescription" minRows="1" maxRows="1" />
			<listGridFilter module="kitchensink" document="LookupDescription" column="number" />
			<listGridSort module="kitchensink" document="LookupDescription" column="description" descending="true" />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="0 SAIL lookup {run} b" />
			<cancel />
			<listGridClearFilter module="kitchensink" document="LookupDescription" />
		</method>
	</interaction>
	<interaction name="Lookups in a view and in an inline grid">
		<description>Makes a Model Lookup Fixture, picks one lookup value from the list and another by typing in the autocomplete, picks a value in an inline grid row, saves and deletes the fixture.</description>
		<method>
			<navigateEdit module="kitchensink" document="ModelLookupFixture" />
			<dataEnter binding="name" value="SAIL model lookup {run}" />
			<lookupDescriptionPick binding="selection" rowContaining="0 SAIL lookup {run} a" />
			<lookupDescriptionAutoComplete binding="singleSelection" search="0 SAIL lookup {run}" pick="{run} b" />
			<dataGridNew binding="rows" />
			<lookupDescriptionPick binding="selection" rowContaining="0 SAIL lookup {run} b" />
			<save />
			<listGridZoom module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" />
			<delete />
		</method>
	</interaction>
	<interaction name="Kitchen sink: a lookup's New and Edit, and data grids">
		<description>Uses a lookup's Edit and New buttons on the Kitchen Sink, then adds, edits, selects and removes rows in its inline, container and ordered data grids.</description>
		<method>
			<navigateEdit module="kitchensink" document="KitchenSink" />
			<dataEnter binding="text" value="Required text" />
			<lookupDescriptionAutoComplete binding="lookupDescription" search="0 SAIL lookup {run} a" />
			<lookupDescriptionEdit binding="lookupDescription" />
			<zoomOut />
			<lookupDescriptionNew binding="lookupDescription" />
			<dataEnter binding="description" value="0 SAIL lookup {run} c" />
			<zoomOut />
			<tabSelect path="Data Grids" />
			<dataGridNew binding="inlineGrid" />
			<dataEnter binding="booleanFlag" value="true" />
			<dataEnter binding="date" value="07-Nov-2025" />
			<dataGridEdit binding="inlineGrid" row="0" />
			<dataEnter binding="booleanFlag" value="false" />
			<dataGridRemove binding="inlineGrid" row="0" />
			<dataGridNew binding="containerGrid" />
			<dataEnter binding="url" value="https://example.com/{run}" />
			<zoomOut />
			<dataGridSelect binding="containerGrid" row="0" />
			<dataGridRemove binding="containerGrid" row="0" />
			<dataGridNew binding="orderedGrid" />
			<dataEnter binding="date" value="01-Jan-2020" />
			<zoomOut />
			<dataGridZoom binding="orderedGrid" rowContaining="01-Jan-2020" />
			<zoomOut />
			<dataGridSelect binding="orderedGrid" rowContaining="01-Jan-2020" />
			<tabSelect path="Widgets" />
		</method>
	</interaction>
	<interaction name="Ordered grid: drag a row">
		<description>Makes an Ordered Grid Fixture with two rows, drags the second above the first, saves and deletes it.</description>
		<method>
			<navigateMenu module="kitchensink" item="Ordered Grid Fixtures" />
			<listGridNew module="kitchensink" document="OrderedGridFixture" />
			<dataEnter binding="name" value="SAIL ordered {run}" />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="First {run}" />
			<zoomOut />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="Second {run}" />
			<zoomOut />
			<dataGridMove binding="rows" rowContaining="Second {run}" to="0" />
			<save />
			<delete />
		</method>
	</interaction>
	<interaction name="Actions fixture: uploads and a link in a row">
		<description>Uploads a file that the Actions Fixture refuses and checks the error, uploads one it accepts, then adds a grid row, declines and confirms its Run From Row link and checks the row ran.</description>
		<method>
			<navigateEdit module="kitchensink" document="ActionsFixture" />
			<upload action="ActionsUpload" file="sail/files/sail-refused.txt" testSuccess="false" />
			<testFailure message="sail-refused.txt already exists" />
			<upload action="ActionsUpload" file="sail/files/sail-upload.txt" />
			<tabSelect path="Rows" />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="SAIL row {run}" />
			<zoomOut />
			<dataGridLink binding="rows" rowContaining="SAIL row {run}" text="Run From Row" confirm="false" />
			<dataGridLink binding="rows" rowContaining="SAIL row {run}" text="Run From Row" />
			<testGridRows binding="rows" rowContaining="Run From Row ran" minRows="1" maxRows="1" />
		</method>
	</interaction>
	<interaction name="Content upload and server-side questions">
		<description>Uploads a file into a content link on the Upload Fixture, then answers a server-side Yes or No question both ways on the Dialogs Fixture and checks each outcome.</description>
		<method>
			<navigateEdit module="kitchensink" document="UploadFixture" />
			<upload binding="contentLinkNone" file="sail/files/sail-upload.txt" />
			<navigateEdit module="kitchensink" document="DialogsFixture" />
			<action name="AskYesNo" />
			<testValue binding="outcome" value="Yes or No answered Yes" />
			<action name="AskYesNo" confirm="false" />
			<testValue binding="outcome" value="Yes or No answered No" />
		</method>
	</interaction>
	<interaction name="List grid selection">
		<description>Selects a row in the List Grid Fixture's Vue list grid.</description>
		<method>
			<navigateEdit module="kitchensink" document="ListGridFixture" />
			<listGridSelect module="kitchensink" query="qListGridFixtureVue" rowContaining="0 SAIL lookup {run} a" />
		</method>
	</interaction>
	<interaction name="List filters on dates and times, typed as the columns show them">
		<description>Makes a List Attributes record and filters the list by dates, times and a timestamp in their on-screen formats with equals and less-than, then clears the filters and deletes the record.</description>
		<method>
			<navigateList module="kitchensink" document="ListAttributes" />
			<listGridNew module="kitchensink" document="ListAttributes" />
			<dataEnter binding="text" value="0 SAIL dates {run}" />
			<dataEnter binding="date" value="15-Jun-2021" />
			<dataEnter binding="monthFirstDate" value="05/06/2026" />
			<dataEnter binding="twelveHourDateTime" value="05/06/2026 02:47 PM" />
			<dataEnter binding="monthNameTimestamp" value="May-06-2026 02:47:25 PM" />
			<dataEnter binding="time" value="10:00" />
			<ok />
			<navigateEdit module="kitchensink" document="ListGridFixture" />
			<comment>A date and a time with the default converters, a month first date, a 12 hour date time, a timestamp with a month name and a date time shown as a date</comment>
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="text" value="{run}" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="date" value="15-Jun-2021" operator="equals" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="monthFirstDate" value="05/06/2026" operator="equals" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="twelveHourDateTime" value="05/07/2026 02:47 PM" operator="lessThan" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="monthNameTimestamp" value="May-07-2026 02:47:25 PM" operator="lessThan" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="time" value="10:00" operator="equals" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="dateTimeAsDate" value="12/31/2099" operator="lessThan" />
			<testGridRows module="kitchensink" query="qListGridFixtureVueAttributes" rowContaining="0 SAIL dates {run}" minRows="1" maxRows="1" />
			<listGridClearFilter module="kitchensink" query="qListGridFixtureVueAttributes" />
			<listGridFilter module="kitchensink" query="qListGridFixtureVueAttributes" column="text" value="{run}" />
			<listGridZoom module="kitchensink" query="qListGridFixtureVueAttributes" rowContaining="0 SAIL dates {run}" />
			<delete />
		</method>
	</interaction>
	<interaction name="A tree, a map and a calendar">
		<description>Opens the Condition Node Tree, the List Attribute Map and the List Attribute Calendar menu items.</description>
		<method>
			<navigateMenu module="kitchensink" item="Condition Node Tree" />
			<navigateMenu module="kitchensink" item="List Attribute Map" />
			<navigateMenu module="kitchensink" item="List Attribute Calendar" />
		</method>
	</interaction>
	<interaction name="Delete the lookup values">
		<description>Deletes the two lookup values made at the start.</description>
		<method>
			<navigateMenu module="kitchensink" item="Lookup values" />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="0 SAIL lookup {run} a" />
			<delete />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="0 SAIL lookup {run} b" />
			<delete />
		</method>
	</interaction>
</automation>
