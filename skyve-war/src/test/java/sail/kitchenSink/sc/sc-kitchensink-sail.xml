	<interaction name="List grids in a view">
		<method>
			<navigateEdit module="kitchensink" document="ModelLookupFixture" />
			<dataEnter binding="name" value="SAIL model lookup {run}" />
			<save />
			<comment>The saved fixture now shows in the view's "Saved selections" list grid</comment>
			<testGridRows module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" minRows="1" maxRows="1" />
			<comment>Lists with no menu item, opened by their URLs: the document's default query, and a query</comment>
			<navigateList module="kitchensink" document="ModelLookupFixture" />
			<testGridRows module="kitchensink" document="ModelLookupFixture" rowContaining="SAIL model lookup {run}" minRows="1" maxRows="1" />
			<navigateList module="kitchensink" query="qModelLookupFixtures" />
			<testGridRows module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" minRows="1" maxRows="1" />
			<navigateEdit module="kitchensink" document="ModelLookupFixture" />
			<comment>Filter and sort a list grid in a view (sc-kitchensink-sail-find.xml covers the operators on a list view)</comment>
			<listGridFilter module="kitchensink" query="qModelLookupFixtures" column="name" value="{run}" />
			<testGridRows module="kitchensink" query="qModelLookupFixtures" minRows="1" maxRows="1" />
			<listGridSort module="kitchensink" query="qModelLookupFixtures" column="name" descending="true" />
			<listGridClearFilter module="kitchensink" query="qModelLookupFixtures" />
			<testGridRows module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" minRows="1" maxRows="1" />
			<listGridSelect module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" />
			<listGridZoom module="kitchensink" query="qModelLookupFixtures" rowContaining="SAIL model lookup {run}" />
			<testValue binding="name" value="SAIL model lookup {run}" />
			<comment>A view opened by URL has no Delete button, so delete from the zoomed-in view</comment>
			<delete />
			<clearContext />
		</method>
	</interaction>

	<interaction name="Ordered grid: drag rows into a new order, and keep it once saved">
		<method>
			<navigateMenu module="kitchensink" item="Ordered Grid Fixtures" />
			<listGridNew module="kitchensink" document="OrderedGridFixture" />
			<dataEnter binding="name" value="SAIL ordered {run}" />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="First {run}" />
			<zoomOut />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="Second {run}" />
			<zoomOut />
			<dataGridNew binding="rows" />
			<dataEnter binding="name" value="Third {run}" />
			<zoomOut />
			<comment>Drag the last row to the top. A captured cell's pattern must find its text, so it checks the row's position</comment>
			<dataGridMove binding="rows" rowContaining="Third {run}" to="0" />
			<captureCell binding="rows" row="0" column="name" variable="top" pattern="^Third " />
			<save />
			<ok />
			<comment>Reopen it from its list, so the rows come from the database in their saved order</comment>
			<listGridZoom module="kitchensink" document="OrderedGridFixture" rowContaining="SAIL ordered {run}" />
			<captureCell binding="rows" row="0" column="name" variable="row0" pattern="^Third " />
			<captureCell binding="rows" row="1" column="name" variable="row1" pattern="^First " />
			<captureCell binding="rows" row="2" column="name" variable="row2" pattern="^Second " />
			<comment>Drag a row down, by its position</comment>
			<dataGridMove binding="rows" row="0" to="2" />
			<captureCell binding="rows" row="0" column="name" variable="row0" pattern="^First " />
			<captureCell binding="rows" row="2" column="name" variable="row2" pattern="^Third " />
			<save />
			<ok />
			<listGridZoom module="kitchensink" document="OrderedGridFixture" rowContaining="SAIL ordered {run}" />
			<captureCell binding="rows" row="0" column="name" variable="row0" pattern="^First " />
			<captureCell binding="rows" row="1" column="name" variable="row1" pattern="^Second " />
			<captureCell binding="rows" row="2" column="name" variable="row2" pattern="^Third " />
			<delete />
		</method>
	</interaction>
	<interaction name="Ordered inline grid and ordered list membership: keep their order once saved">
		<method>
			<comment>Lookup values to be members</comment>
			<navigateMenu module="kitchensink" item="Lookup values" />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="SAIL member {run} a" />
			<save />
			<ok />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="SAIL member {run} b" />
			<save />
			<ok />
			<listGridNew module="kitchensink" document="LookupDescription" />
			<dataEnter binding="description" value="SAIL member {run} c" />
			<save />
			<ok />
			<navigateMenu module="kitchensink" item="Ordered Grid Fixtures" />
			<listGridNew module="kitchensink" document="OrderedGridFixture" />
			<dataEnter binding="name" value="SAIL ordered lines {run}" />
			<comment>The ordered inline grid: inline adds, a drag, and an inline edit</comment>
			<dataGridNew binding="lines" />
			<dataEnter binding="name" value="First {run}" />
			<dataGridNew binding="lines" />
			<dataEnter binding="name" value="Second {run}" />
			<dataGridNew binding="lines" />
			<dataEnter binding="name" value="Third {run}" />
			<dataGridMove binding="lines" rowContaining="Third {run}" to="0" />
			<dataGridEdit binding="lines" row="1" />
			<dataEnter binding="name" value="First edited {run}" />
			<comment>An inline edit of a row found by its text</comment>
			<dataGridEdit binding="lines" rowContaining="Second {run}" />
			<dataEnter binding="name" value="Second edited {run}" />
			<comment>The ordered membership: SmartClient assigns members in the order the value names them, then they are dragged into a new order</comment>
			<dataEnter binding="members" value="SAIL member {run} c|SAIL member {run} a|SAIL member {run} b" />
			<listMembershipMove binding="members" rowContaining="SAIL member {run} b" to="0" />
			<testValue binding="members" value="SAIL member {run} b|SAIL member {run} c|SAIL member {run} a" />
			<listMembershipMove binding="members" row="1" to="2" />
			<testValue binding="members" value="SAIL member {run} b|SAIL member {run} a|SAIL member {run} c" />
			<save />
			<ok />
			<comment>Reopen it from its list, so the order comes from the database</comment>
			<listGridZoom module="kitchensink" document="OrderedGridFixture" rowContaining="SAIL ordered lines {run}" />
			<captureCell binding="lines" row="0" column="name" variable="line0" pattern="^Third " />
			<captureCell binding="lines" row="1" column="name" variable="line1" pattern="^First edited " />
			<captureCell binding="lines" row="2" column="name" variable="line2" pattern="^Second edited " />
			<testValue binding="members" value="SAIL member {run} b|SAIL member {run} a|SAIL member {run} c" />
			<delete />
			<navigateMenu module="kitchensink" item="Lookup values" />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="SAIL member {run} a" />
			<delete />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="SAIL member {run} b" />
			<delete />
			<listGridZoom module="kitchensink" document="LookupDescription" rowContaining="SAIL member {run} c" />
			<delete />
		</method>
	</interaction>
	<interaction name="Logout">
		<method>
			<logout />
		</method>
	</interaction>
</automation>
