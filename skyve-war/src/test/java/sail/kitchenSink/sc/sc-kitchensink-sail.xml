			<testWidget binding="outcome" enabled="false" />
		</method>
	</interaction>

	<interaction name="Conditions Fixture: visible and enabled conditions">
		<method>
			<comment>SAIL waits for SmartClient to settle after each step, so a widget that keeps its form redrawing fails here</comment>
			<comment>Show and Allow start ticked, so the form items are shown and enabled; changing either rerenders the view</comment>
			<navigateEdit module="kitchensink" document="ConditionsFixture" />
			<testWidget binding="slider1" visible="true" enabled="true" />
			<testWidget binding="password1" visible="true" enabled="true" />
			<dataEnter binding="slider1" value="7" />
			<testValue binding="slider1" value="7" />
			<comment>slider1 is shown by a Skyve expression and enabled by a Java condition; password1 the other way round</comment>
			<dataEnter binding="show" value="false" />
			<testWidget binding="slider1" visible="false" />
			<testWidget binding="password1" visible="false" />
			<dataEnter binding="allow" value="false" />
			<dataEnter binding="show" value="true" />
			<testWidget binding="slider1" visible="true" enabled="false" />
			<testWidget binding="password1" visible="true" enabled="false" />
			<dataEnter binding="allow" value="true" />
			<testWidget binding="slider1" visible="true" enabled="true" />
			<testWidget binding="password1" visible="true" enabled="true" />
			<testValue binding="slider1" value="7" />
		</method>
	</interaction>

