<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideCustomerOnly"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Customer override fixture: a persistent document only the test customer has, with an owner
			OverrideAdds, whose inverse only the test customer's override of OverrideAdds declares.
		]]>
	</documentation>
	<persistent name="TEST_OverrideCustomerOnly" />
	<singularAlias>Override Customer Only</singularAlias>
	<pluralAlias>Override Customer Only</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="text">
			<displayName>Text</displayName>
			<length>100</length>
		</text>
		<association name="owner" type="aggregation">
			<displayName>Owner</displayName>
			<documentName>OverrideAdds</documentName>
		</association>
	</attributes>
</document>
