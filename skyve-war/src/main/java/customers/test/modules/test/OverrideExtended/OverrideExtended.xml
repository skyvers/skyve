<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideExtended"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			The test customer's override of OverrideExtended, adding customerText. The test customer's own OverrideExtendedExtension extends its generated class.
		]]>
	</documentation>
	<persistent name="TEST_OverrideExtended" />
	<singularAlias>Override Extended</singularAlias>
	<pluralAlias>Override Extended</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="text">
			<displayName>Text</displayName>
			<length>100</length>
		</text>
		<text name="customerText">
			<displayName>Customer Text</displayName>
			<length>100</length>
		</text>
	</attributes>
</document>
