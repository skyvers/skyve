<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideEnumReferrer"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Customer override fixture: references OverrideNarrowed and its status enum, which the test customer's override leaves out and the test2 customer's keeps.
		]]>
	</documentation>
	<persistent name="TEST_OverrideEnumReferrer" />
	<singularAlias>Override Enum Referrer</singularAlias>
	<pluralAlias>Override Enum Referrer</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="text">
			<displayName>Text</displayName>
			<length>100</length>
		</text>
		<association name="narrowed" type="aggregation">
			<displayName>Narrowed</displayName>
			<documentName>OverrideNarrowed</documentName>
		</association>
		<enum name="narrowedStatus" documentRef="OverrideNarrowed" attributeRef="status">
			<displayName>Narrowed Status</displayName>
		</enum>
	</attributes>
</document>
