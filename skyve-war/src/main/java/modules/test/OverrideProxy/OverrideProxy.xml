<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideProxy"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Customer override fixture: a mapped base with its own table, which OverrideProxied shares, as admin.UserProxy is for admin.User.
		]]>
	</documentation>
	<persistent name="TEST_OverrideProxied" strategy="mapped" />
	<singularAlias>Override Proxy</singularAlias>
	<pluralAlias>Override Proxy</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="text">
			<displayName>Text</displayName>
			<length>100</length>
		</text>
	</attributes>
</document>
