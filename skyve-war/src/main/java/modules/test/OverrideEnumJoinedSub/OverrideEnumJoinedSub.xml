<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideEnumJoinedSub"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Customer override fixture: a joined subclass with an enum, which the test customer's override leaves out.
		]]>
	</documentation>
	<extends document="OverrideEnumJoinedBase" />
	<persistent name="TEST_OverrideEnumJoinedSub" strategy="joined" />
	<singularAlias>Override Enum Joined Sub</singularAlias>
	<pluralAlias>Override Enum Joined Sub</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="subText">
			<displayName>Sub Text</displayName>
			<length>100</length>
		</text>
		<enum name="status">
			<displayName>Status</displayName>
			<values>
				<value code="open" />
				<value code="closed" />
			</values>
		</enum>
	</attributes>
</document>
