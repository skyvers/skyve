<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OverrideLength"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Customer override fixture: the test customer's override gives text a longer length.
		]]>
	</documentation>
	<persistent name="TEST_OverrideLength" />
	<singularAlias>Override Length</singularAlias>
	<pluralAlias>Override Length</pluralAlias>
	<bizKey expression="{text}" />
	<attributes>
		<text name="text">
			<displayName>Text</displayName>
			<length>50</length>
		</text>
	</attributes>
</document>
