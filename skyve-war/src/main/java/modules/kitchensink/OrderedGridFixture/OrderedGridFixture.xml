<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="OrderedGridFixture"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Kitchen Sink fixture for an ordered data grid that is saved: its rows can be dragged into a new order,
			and the order is kept by their ordinals.
		]]>
	</documentation>
	<persistent name="KS_OrderedGridFixture" />
	<singularAlias>Ordered Grid Fixture</singularAlias>
	<pluralAlias>Ordered Grid Fixtures</pluralAlias>
	<bizKey expression="{name}" />
	<attributes>
		<text name="name" required="true">
			<displayName>Name</displayName>
			<length>100</length>
		</text>
		<collection name="rows" type="child" ordered="true">
			<displayName>Rows</displayName>
			<description>An ordered collection: its rows can be dragged into a new order.</description>
			<documentName>OrderedGridFixtureRow</documentName>
			<minCardinality>0</minCardinality>
		</collection>
	</attributes>
</document>
