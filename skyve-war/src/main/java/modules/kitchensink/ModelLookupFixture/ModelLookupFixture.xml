<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<document name="ModelLookupFixture"
			xmlns="http://www.skyve.org/xml/document"
			xsi:schemaLocation="http://www.skyve.org/xml/document ../../../schemas/document.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<persistent name="KS_ModelLookupFixture" />
	<singularAlias>Model Lookup Fixture</singularAlias>
	<pluralAlias>Model Lookup Fixtures</pluralAlias>
	<bizKey expression="{name}" />
	<attributes>
		<text name="name" required="true">
			<displayName>Name</displayName>
			<defaultValue>Model lookup example</defaultValue>
			<length>100</length>
		</text>
		<association name="selection" type="aggregation">
			<displayName>Form Model Lookup</displayName>
			<documentName>LookupDescription</documentName>
		</association>
		<collection name="rows" type="child">
			<displayName>Model Lookup Rows</displayName>
			<documentName>ModelLookupRow</documentName>
			<minCardinality>0</minCardinality>
		</collection>
		<association name="singleSelection" type="aggregation">
			<displayName>Single-column Model Lookup</displayName>
			<documentName>LookupDescription</documentName>
		</association>
	</attributes>
</document>
