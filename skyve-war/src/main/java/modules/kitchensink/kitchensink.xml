<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<module name="kitchensink"
			title="Kitchen Sink"
			xmlns="http://www.skyve.org/xml/module"
			xsi:schemaLocation="http://www.skyve.org/xml/module ../../schemas/module.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<homeRef>edit</homeRef>
	<homeDocument>KitchenSink</homeDocument>
	<documents>
		<document ref="KitchenSink" />
		<document ref="ContainerGrid" />
		<document ref="InlineGrid" />
		<document ref="ListAttributes" />
		<document ref="OrderedGrid" />
		<document ref="DataRepeater" />
		<document ref="EscapingFixture" />
		<document ref="UploadFixture" />
		<document ref="UploadFixtureGridRow" />
		<document ref="LookupDescription" />
		<document ref="ModelLookupFixture" />
		<document ref="ModelLookupRow" />
		<document ref="ConditionsFixture" />
		<document ref="ConditionsFixtureRow" />
		<document ref="ConditionsFixtureNode" />
		<document ref="DialogsFixture" />
		<document ref="DialogsFixtureRow" />
		<document ref="ActionsFixture" />
		<document ref="ActionsFixtureRow" />
	</documents>
	<roles>
		<role name="dev">
			<description>Dev</description>
			<privileges>
				<document name="KitchenSink" permission="_____">
					<contentPermission attribute="contentImage" />
					<contentPermission attribute="contentLink" />
					<contentPermission attribute="contentSignature" />
				</document>
				<document name="ContainerGrid" permission="CRUDD" />
				<document name="InlineGrid" permission="CRUDD" />
				<document name="ListAttributes" permission="CRUDD" />
				<document name="OrderedGrid" permission="CRUDD" />
				<document name="DataRepeater" permission="CRUDD" />
				<document name="EscapingFixture" permission="CRUDD">
					<action name="TrustedDisplayName" />
				</document>
				<document name="UploadFixture" permission="CRUDD">
					<action name="UploadGeneric" />
					<action name="UploadCamera" />
					<action name="UploadVideo" />
					<action name="UploadAll" />
					<contentPermission attribute="contentAutoNone" />
					<contentPermission attribute="contentAutoCamera" />
					<contentPermission attribute="contentAutoVideo" />
					<contentPermission attribute="contentAutoAll" />
					<contentPermission attribute="contentLinkNone" />
					<contentPermission attribute="contentLinkCamera" />
					<contentPermission attribute="contentLinkVideo" />
					<contentPermission attribute="contentLinkAll" />
					<contentPermission attribute="contentImageNone" />
					<contentPermission attribute="contentImageCamera" />
					<contentPermission attribute="contentImageAll" />
					<contentPermission attribute="contentVideoNone" />
					<contentPermission attribute="contentVideoVideo" />
					<contentPermission attribute="contentVideoAll" />
					<contentPermission attribute="contentDisabledAuto" />
					<contentPermission attribute="contentDisabledImage" />
					<contentPermission attribute="contentReadOnlyLink" />
					<contentPermission attribute="contentReadOnlyVideo" />
				</document>
				<document name="UploadFixtureGridRow" permission="CRUDD">
					<contentPermission attribute="boundColumnContent" />
					<contentPermission attribute="containerColumnContent" />
				</document>
				<document name="LookupDescription" permission="CRUDD" />
				<document name="ModelLookupFixture" permission="CRUDD" />
				<document name="ModelLookupRow" permission="CRUDD" />
				<document name="ConditionsFixture" permission="CRUDD">
					<action name="ConditionsAction1" />
					<action name="ConditionsAction2" />
					<action name="ConditionsAction3" />
					<action name="ConditionsAction4" />
					<action name="ConditionsExport" />
					<action name="ConditionsImport" />
					<action name="ConditionsDownload" />
					<action name="ConditionsUpload" />
					<contentPermission attribute="content1" />
					<contentPermission attribute="content2" />
					<contentPermission attribute="content3" />
					<contentPermission attribute="content4" />
					<contentPermission attribute="contentSignature1" />
					<contentPermission attribute="contentSignature2" />
					<contentPermission attribute="contentSignature3" />
					<contentPermission attribute="contentSignature4" />
				</document>
				<document name="ConditionsFixtureRow" permission="CRUDD">
					<contentPermission attribute="content" />
				</document>
				<document name="ConditionsFixtureNode" permission="CRUDD" />
				<document name="DialogsFixture" permission="CRUDD">
					<action name="AskOnce" />
					<action name="AskTwice" />
					<action name="AskYesNo" />
					<action name="AskEveryRun" />
					<action name="SaveThenAsk" />
					<action name="AskWrapped" />
				</document>
				<document name="DialogsFixtureRow" permission="CRUDD" />
				<document name="ActionsFixture" permission="CRUDD">
					<action name="RunFromToolbar" />
					<action name="RunFromEvent" />
					<action name="RunWithoutTrigger" />
					<action name="RunFromFormButton" />
					<action name="RunFromTabButton" />
					<action name="RunShared" />
					<action name="DownloadOnce" />
					<action name="ActionsExport" />
					<action name="ActionsImport" />
					<action name="ActionsUpload" />
				</document>
				<document name="ActionsFixtureRow" permission="CRUDD">
					<action name="RunFromRow" />
					<action name="ExportFromRow" />
				</document>
			</privileges>
		</role>
	</roles>
	<menu>
		<edit name="Kitchen Sink" document="KitchenSink">
			<role name="dev" />
		</edit>
		<link href="#" name="Calendar">
			<role name="dev" />
		</link>
		<list name="List" document="ListAttributes">
			<role name="dev" />
		</list>
		<edit name="Escaping Fixture" document="EscapingFixture">
			<role name="dev" />
		</edit>
		<edit name="Upload Fixture" document="UploadFixture">
			<role name="dev" />
		</edit>
		<link href="#" name="Map">
			<role name="dev" />
		</link>
		<link href="#" name="Tree">
			<role name="dev" />
		</link>
		<list name="Lookup values" document="LookupDescription">
			<role name="dev" />
		</list>
		<edit name="Model Lookup Fixture" document="ModelLookupFixture">
			<role name="dev" />
		</edit>
		<edit name="Conditions Fixture" document="ConditionsFixture">
			<role name="dev" />
		</edit>
		<edit name="Dialogs Fixture" document="DialogsFixture">
			<role name="dev" />
		</edit>
		<edit name="Actions Fixture" document="ActionsFixture">
			<role name="dev" />
		</edit>
	</menu>
	<queries>
		<query name="qEscapingFixture" documentName="ListAttributes">
			<description>Small query used by the Kitchen Sink escaping fixture view.</description>
			<columns>
				<column binding="text" displayName="Text" />
			</columns>
		</query>
		<query name="qModelLookupValues" documentName="LookupDescription">
			<description>Model lookup values</description>
			<columns>
				<column binding="description" displayName="Lookup Description" sortOrder="ascending" />
				<column binding="bizId" displayName="Record ID" />
			</columns>
		</query>
		<query name="qModelLookupFixtures" documentName="ModelLookupFixture">
			<description>Saved model lookup selections</description>
			<columns>
				<column binding="name" />
				<column binding="selection" displayName="Selected Lookup" />
				<column binding="selection.description" displayName="Selected Description" />
				<column binding="singleSelection.description" displayName="Single-column Selection" />
			</columns>
		</query>
		<query name="qConditionsFixtureListAttributes" documentName="ListAttributes">
			<description>List attributes listed by the list grids and list repeaters of the Kitchen Sink conditions fixture view.</description>
			<columns>
				<column binding="text" displayName="Text" />
			</columns>
		</query>
		<query name="qConditionsFixtureNodes" documentName="ConditionsFixtureNode">
			<description>Nodes listed by the tree grids of the Kitchen Sink conditions fixture view.</description>
			<columns>
				<column binding="text" displayName="Text" />
			</columns>
		</query>
	</queries>
</module>
