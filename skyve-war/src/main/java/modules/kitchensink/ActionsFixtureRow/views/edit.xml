<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<view name="edit"
		title="Actions Fixture Row"
		xmlns="http://www.skyve.org/xml/view"
		xsi:schemaLocation="http://www.skyve.org/xml/view ../../../../schemas/view.xsd"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<form border="true">
		<column responsiveWidth="3" />
		<column responsiveWidth="9" />
		<row>
			<item>
				<textField binding="name" />
			</item>
		</row>
		<row>
			<item showHelp="true">
				<checkBox binding="hideLink" triState="false" />
			</item>
		</row>
		<row>
			<item showHelp="true">
				<checkBox binding="disableRowAction" triState="false" />
			</item>
		</row>
		<row>
			<item>
				<textField binding="outcome" enabled="false" />
			</item>
		</row>
	</form>
	<actions>
		<defaults />
		<!-- Named apart from its class so the row link must send the class; the confirmation's quotes, ampersand and braces are shown as written -->
		<action name="runFromRowLink" className="RunFromRow" displayName="Run From Row" inActionPanel="false" disabled="rowActionDisabled"
				confirm="Run &quot;Run From Row&quot; &amp; record {outcome}?" />
		<export className="ExportFromRow" displayName="Export From Row" />
	</actions>
</view>
