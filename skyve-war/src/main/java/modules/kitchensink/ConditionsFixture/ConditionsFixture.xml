			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<documentation>
		<![CDATA[
			Non-persistent Kitchen Sink fixture whose edit view puts a condition on every view attribute that takes one.

			Show drives every visible/invisible condition and Allow drives every other condition, so that each widget
			on the first four tabs of the edit view is shown when Show is set and usable when Allow is set.
			Those tabs author the same widgets four ways: positive attributes (visible, enabled, enableAdd...) and
			negative attributes (invisible, disabled, disableAdd...), each holding condition names and then inline expressions.
			An attribute ending in 1, 2, 3 or 4 is bound on the tab of that number.
		]]>
	</documentation>
	<singularAlias>Conditions Fixture</singularAlias>
	<pluralAlias>Conditions Fixtures</pluralAlias>
	<bizKey expression="Conditions Fixture" />
	<attributes>
		<boolean name="show">
			<displayName>Show</displayName>
			<description>Drives every visible and invisible condition on the four attribute tabs: when it is ticked, every widget there is shown. Changing it refreshes the view.</description>
			<defaultValue>true</defaultValue>
		</boolean>
		<boolean name="allow">
			<displayName>Allow</displayName>
			<description>Drives every other condition on the four attribute tabs (enabled and disabled, the add, edit, zoom, remove, pick and clear flags, and postRefresh): when it is ticked, every widget there can be used. Changing it refreshes the view.</description>
			<defaultValue>true</defaultValue>
		</boolean>
		<text name="text">
			<displayName>Text</displayName>
			<description>Type x to flip the two el:bean.text eq 'x' labels on the Condition forms tab: the visible one appears and the invisible one disappears. Type mapped to show the component's el:bean.text eq 'mapped' label on the first three attribute tabs; on the fourth that condition is mapped to shownByExpression, so there it follows Show. Changing it does not refresh the view: tick Show or Allow, or save, to see the effect.</description>
			<length>100</length>
		</text>
		<integer name="number">
			<displayName>Number</displayName>
			<description>Enter 6 or more to flip the two el:bean.number gt 5 labels on the Condition forms tab. Changing it does not refresh the view: tick Show or Allow, or save, to see the effect.</description>
		</integer>
		<enum name="choice">
			<displayName>Choice</displayName>
			<description>Choose one to flip the two el:bean.choice eq Choice.one labels on the Condition forms tab. Changing it does not refresh the view: tick Show or Allow, or save, to see the effect.</description>
			<values>
				<value code="one" />
				<value code="two" />
			</values>
		</enum>
