<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE project>
<project name="build-vue" default="copy-artifacts" basedir=".">
	<property name="skyvevueDir" value="../skyve-web/src/main/resources/META-INF/resources/skyve/vue" />
	<target name="copy-artifacts" depends="build-vue">
		<echo>Copying dist/assets directory to skyve-web</echo>
		<copy  todir="${skyvevueDir}" verbose="true">
			<fileset dir="./dist/assets" includes="skyve.js,skyve.css" />
		</copy>
		<!-- No primeicons stylesheet or fonts: PrimeFaces adds its own primeicons.css to every page -->
		<!-- Drop the Lara theme's Inter font - the templates use their own font (see alignFont() in main.js) -->
		<replaceregexp file="${skyvevueDir}/skyve.css" match="@font-face\{font-family:Inter var;[^}]*\}" replace="" flags="g" />
	</target>
	<target name="build-vue">
		<echo>Running npm/vite build [${os.name}]</echo>
		<exec executable="cmd" osfamily="windows" failonerror="true">
			<arg value="/c" />
			<arg value="npm.cmd" />
			<arg value="run" />
			<arg value="build" />
		</exec>
		<exec executable="/bin/sh" osfamily="unix" failonerror="true">
			<arg value="-lc" />
			<arg value="npm run build" />
		</exec>
	</target>
</project>
